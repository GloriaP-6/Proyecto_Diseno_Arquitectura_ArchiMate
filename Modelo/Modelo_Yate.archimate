      <property key="Dominio(s) de Fase 3" value="Admisibilidad y Cumplimiento"/>
      <property key="Agregados (Fase 4)" value="ExpedienteCumplimiento"/>
      <property key="Responsable lógico" value="Responsable de cumplimiento"/>
      <property key="Lenguaje ubicuo clave" value="Contraparte, PEP, Beneficiario final, Decisión de cumplimiento"/>
