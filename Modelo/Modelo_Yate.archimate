      <property key="Salida" value="Cobro aplicado por fuente."/>
      <property key="Reglas de negocio" value="Orden: depósito primero, luego seguro (deducible a cargo del cliente) y, si queda saldo, cobro directo al cliente según contrato."/>
      <property key="Errores y excepciones" value="Saldo no recuperable."/>
      <property key="Calidad" value="Tras vencer las 48 h de objeción (entrevista §5)."/>
