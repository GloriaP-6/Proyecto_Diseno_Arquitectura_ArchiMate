    <element xsi:type="archimate:Driver" name="Expectativas de rapidez y transparencia de los clientes" id="id-06777d2f471f4b5b9fe0c7873fafbbc6"/>
    <element xsi:type="archimate:Assessment" name="Fortalezas: red de marinas, contratos con propietarios y reputación" id="id-e2fb7b6c1cbd4cb29429941482b4493d"/>
