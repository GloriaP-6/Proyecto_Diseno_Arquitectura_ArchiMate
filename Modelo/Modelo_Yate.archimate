      <folder name="Gestión de Propietarios y Yates" id="2c50fc0d-8b1e-434c-8c7d-b98634d6e05f">
        <element xsi:type="archimate:DataObject" name="VinculacionPropietario «Aggregate Root»" id="89b5aa27-6592-4431-a5c9-2fa9e16afe07">
          <documentation>Rol DDD: Aggregate Root. PENDIENTE → ACTIVA → SUSPENDIDA → TERMINADA.
Referencias externas: PropietarioId
Invariantes:
1. Una vinculación ACTIVA requiere exclusividad vigente.
2. TERMINADA no vuelve a ACTIVA; un nuevo vínculo se registra como nueva relación.
3. La identidad del propietario se conserva como referencia estable.</documentation>
        </element>
        <element xsi:type="archimate:DataObject" name="ContratoExclusividad «Value Object»" id="d1ca5dbd-82b9-4ac0-9176-e8c25c386b8f">
          <documentation>Objeto de valor del agregado VinculacionPropietario; se define por sus valores, no por identidad independiente.</documentation>
        </element>
        <element xsi:type="archimate:DataObject" name="EstadoVinculacion «Value Object»" id="02a7d260-5fc1-4df4-b604-a4014d3c0109">
          <documentation>Objeto de valor del agregado VinculacionPropietario; se define por sus valores, no por identidad independiente.</documentation>
        </element>
        <element xsi:type="archimate:DataObject" name="YateComercializable «Aggregate Root»" id="898ac6e3-b999-4107-b40a-484d44b5db78">
          <documentation>Rol DDD: Aggregate Root. REGISTRADO → HABILITADO ↔ BLOQUEADO; también SUSPENDIDO. HABILITADO es condición necesaria, no sinónimo de disponibilidad para cualquier fecha.
Referencias externas: PropietarioId · VinculacionId · MarinaId
Invariantes:
1. Solo se habilita con vinculación activa.
2. No se habilita con póliza anual vencida, documentación incompleta o mantenimiento pendiente.
3. Bloqueos vigentes impiden disponibilidad en el periodo afectado.
4. Los bloqueos de uso personal sin penalización respetan el máximo anual pactado.
5. La disponibilidad además depende del periodo solicitado y reservas/bloqueos operativos; habilitado ≠ disponible.</documentation>
        </element>
        <element xsi:type="archimate:DataObject" name="PeriodoBloqueo «Entity»" id="a9d2d013-cb78-4aad-8cd3-998d045e67e4">
          <documentation>Entidad interna del agregado YateComercializable. Tiene identidad y ciclo de vida propio dentro del límite.</documentation>
        </element>
        <element xsi:type="archimate:DataObject" name="EstadoHabilitacionYate «Value Object»" id="4da70b2e-8a31-449b-aa63-c8913124accc">
          <documentation>Objeto de valor del agregado YateComercializable; se define por sus valores, no por identidad independiente.</documentation>
        </element>
        <element xsi:type="archimate:DataObject" name="ReferenciaPolizaAnual «Value Object»" id="c6aea61b-5004-4b99-8be1-54167db4b2be">
          <documentation>Objeto de valor del agregado YateComercializable; se define por sus valores, no por identidad independiente.</documentation>
        </element>
        <element xsi:type="archimate:DataObject" name="EstadoDocumentacion «Value Object»" id="d3f0be92-66b7-408e-882d-7a6d8efe0390">
          <documentation>Objeto de valor del agregado YateComercializable; se define por sus valores, no por identidad independiente.</documentation>
        </element>
        <element xsi:type="archimate:DataObject" name="EstadoMantenimiento «Value Object»" id="661e85cd-0a4c-4548-9b1d-265b89f826cd">
          <documentation>Objeto de valor del agregado YateComercializable; se define por sus valores, no por identidad independiente.</documentation>
        </element>
        <element xsi:type="archimate:DataObject" name="CupoUsoPersonal «Value Object»" id="b9f75a38-1368-437a-98ec-c210ad8face8">
          <documentation>Objeto de valor del agregado YateComercializable; se define por sus valores, no por identidad independiente.</documentation>
        </element>
        <element xsi:type="archimate:DataObject" name="MotivoBloqueo «Value Object»" id="9e35ae8e-03ea-4ca6-a7f2-27e8a1a7c8a9">
          <documentation>Objeto de valor del agregado YateComercializable; se define por sus valores, no por identidad independiente.</documentation>
        </element>
        <element xsi:type="archimate:DataObject" name="DisponibilidadPeriodo «Value Object»" id="b8acbe89-f1f6-4f43-a827-ff60078febb8">
          <documentation>Objeto de valor del agregado YateComercializable que expresa disponibilidad para un periodo solicitado. Considera habilitación, bloqueos de propietario/mantenimiento, póliza/documentación, estado operacional y periodos ya comprometidos por reservas; HABILITADO no significa automáticamente DISPONIBLE para cualquier fecha.</documentation>
        </element>
        <element xsi:type="archimate:DataObject" name="ActivarVinculacion «Command»" id="a4fdf53c-0a7e-4295-b6ed-1bd456203a75">
          <documentation>Mapeo DDD→ArchiMate: Data Object que representa una intención/solicitud. No es un metatipo nativo de ArchiMate.</documentation>
        </element>
        <element xsi:type="archimate:DataObject" name="RenovarExclusividad «Command»" id="49816311-2413-4960-aa00-2372328c8a7d">
          <documentation>Mapeo DDD→ArchiMate: Data Object que representa una intención/solicitud. No es un metatipo nativo de ArchiMate.</documentation>
        </element>
        <element xsi:type="archimate:DataObject" name="HabilitarYate «Command»" id="ca4907e1-833b-476f-bdfd-da9118b2612d">
          <documentation>Mapeo DDD→ArchiMate: Data Object que representa una intención/solicitud. No es un metatipo nativo de ArchiMate.</documentation>
        </element>
        <element xsi:type="archimate:DataObject" name="BloquearYate «Command»" id="d5c73cba-9f7c-4496-8c14-a733a042d4d8">
