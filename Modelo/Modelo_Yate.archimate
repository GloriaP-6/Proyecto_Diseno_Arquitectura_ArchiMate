      <property key="Nivel" value="2"/>
      <property key="Relación con la solución" value="Impacta (alta)"/>
    </element>
    <element xsi:type="archimate:Capability" name="Gestión del inventario de yates por marina" id="id-7d12e6be3cf94c9cbb25b9010efa6a3e">
      <property key="Nivel" value="2"/>
      <property key="Relación con la solución" value="Impacta (alta)"/>
