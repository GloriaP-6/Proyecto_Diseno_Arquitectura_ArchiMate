    <element xsi:type="archimate:ValueStream" name="Preparación y entrega" id="id-2988155db94046d48479dee124bde49e"/>
    <element xsi:type="archimate:ValueStream" name="Navegación y seguimiento" id="id-e5eca6388d5e44048011d03e7f6e0914"/>
    <element xsi:type="archimate:ValueStream" name="Devolución y cierre" id="id-bb7327ef234142dc95ebecc118ad54b6"/>
    <element xsi:type="archimate:ValueStream" name="Reputación y liquidación" id="id-b1ebea0157b04a5e9c6bb8a0a7605302"/>
  </folder>
  <folder name="Business" id="id-204ecaef393c4b4ba5f9f9019554cdf9" type="business">
    <folder name="Fase 3 - Business" id="id-975333add88a4f2e8d312f25fa4c6ca6">
      <element xsi:type="archimate:Representation" name="Solicitud de reserva" id="fa36d8a9-06ba-40ed-acd7-5fcea23a1ce3">
        <documentation>Dominio: Gestión del Arrendamiento
Definición: Intención formal del cliente de iniciar la validación para un yate y unas fechas determinadas.
Ejemplo: El cliente acepta la cotización y envía la solicitud para comenzar elegibilidad, riesgo y cumplimiento.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Reserva" id="42e6f710-1d18-4dd7-8a72-cd8ccfb49829">
        <documentation>Dominio: Gestión del Arrendamiento
Definición: Compromiso previo a la ejecución del arriendo, confirmado cuando se cumplen las validaciones, formalización y condiciones requeridas.
Ejemplo: La reserva queda confirmada después de elegibilidad, riesgo, cumplimiento, pago inicial, contrato y registro de póliza.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Arriendo" id="80a96c56-e7cf-46ee-ad1c-1507468b502d">
        <documentation>Dominio: Gestión del Arrendamiento
Definición: Operación completa que articula reserva, validaciones, formalización, preparación, utilización, devolución y cierre de un yate de terceros.
Ejemplo: Arriendo del yate de 40 pies por dos días, desde la confirmación hasta el cierre económico.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Cierre del arriendo" id="a0e485dc-39ec-4294-81c7-29ddbb48b7de">
        <documentation>Dominio: Gestión del Arrendamiento
Definición: Estado final alcanzado después de devolución, inspección, liquidación y resolución de saldos y novedades.
Ejemplo: Se aplican o liberan valores pendientes y el arriendo queda cerrado.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Resultado de evaluación externa" id="1da34585-3d01-41c7-9cfe-253dae8b2b71">
        <documentation>Dominio: Decisión de Riesgo del Arrendamiento
Definición: Resultado producido por el evaluador externo y registrado en la plataforma, compuesto por score, recomendación, alertas y evidencia disponible.
Ejemplo: El analista registra score 72, recomendación de riesgo medio y el soporte recibido del evaluador.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Decisión de riesgo" id="3eee3147-a56e-4c9a-8da7-d9aeb73f9e4a">
        <documentation>Dominio: Decisión de Riesgo del Arrendamiento
Definición: Decisión interna de aceptar, condicionar o rechazar un arriendo específico.
Ejemplo: Aprobado con capitán obligatorio y depósito mayor.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Condición de riesgo" id="fc408bf1-c627-4cd9-ba47-c5323a93ddf9">
        <documentation>Dominio: Decisión de Riesgo del Arrendamiento
Definición: Medida adicional exigida para reducir la exposición aceptada por la empresa.
Ejemplo: Aumentar el depósito o exigir capitán.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Exposición del arriendo" id="298f782e-71af-4aa4-b4ba-d3477ebb2b87">
        <documentation>Dominio: Decisión de Riesgo del Arrendamiento
Definición: Nivel de riesgo que representa entregar un yate concreto bajo unas condiciones concretas.
Ejemplo: Un yate de mayor valor eleva la exposición.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Propietario" id="dbbdcd03-d4a5-4c4b-ac72-158ae4d16b04">
        <documentation>Dominio: Gestión de Propietarios y Yates
Definición: Persona o empresa titular del yate que lo entrega para comercialización exclusiva.
Ejemplo: Propietario con contrato renovable de 12 meses.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Habilitación" id="64146b01-36ba-49d1-b771-a46f68b56cda">
        <documentation>Dominio: Gestión de Propietarios y Yates
Definición: Estado que permite ofrecer un yate para arriendo cuando cumple documentos, póliza anual y condiciones requeridas.
Ejemplo: Póliza y certificados vigentes: yate habilitado.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Bloqueo" id="9b04a258-6623-414d-8122-4fcf0d492b2b">
        <documentation>Dominio: Gestión de Propietarios y Yates
Definición: Estado que impide ofrecer o entregar el yate por decisión del propietario o por una restricción de la empresa.
Ejemplo: Bloqueo por mantenimiento pendiente.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Póliza anual" id="682305f8-be69-43c0-ab2d-fcd1935ed910">
        <documentation>Dominio: Gestión de Propietarios y Yates
Definición: Seguro permanente a cargo del propietario, exigido para mantener habilitado el yate.
Ejemplo: Póliza anual vencida produce bloqueo.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Orden de alistamiento" id="a54f875e-3460-45d4-84a5-2a8761b04f59">
        <documentation>Dominio: Gestión de Marinas y Operación Náutica
Definición: Instrucción enviada a la marina para preparar el yate asociado a una reserva.
Ejemplo: La reserva confirmada genera orden para la marina.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Alistamiento" id="1bfa421f-931c-410b-9d00-065f0a61166e">
        <documentation>Dominio: Gestión de Marinas y Operación Náutica
Definición: Preparación física del yate antes de la entrega al cliente.
Ejemplo: La marina completa checklist previo.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Entrega" id="4858e1a3-b0b2-4e05-ba6a-56d9554e65ed">
        <documentation>Dominio: Gestión de Marinas y Operación Náutica
Definición: Acto físico de poner el yate a disposición del cliente y registrar su estado inicial.
Ejemplo: Se firman fotos, combustible y acta de entrega.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Inspección" id="fe4c7d6d-9ad9-44ae-892b-c8d712614d3a">
        <documentation>Dominio: Gestión de Marinas y Operación Náutica
Definición: Revisión física conjunta al retorno para determinar estado, daños y combustible.
Ejemplo: La marina emite informe dentro de 24 horas.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Incidente" id="2eb1e1b8-388e-4c6e-b3ed-a03f11237f99">
        <documentation>Dominio: Gestión de Incidentes y Siniestros
Definición: Situación anormal durante el arriendo que exige atención, seguimiento o escalamiento.
Ejemplo: Salida de zona permitida sin respuesta del cliente.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Siniestro" id="6669fee8-00b1-43de-a836-8d4ceeecbc53">
        <documentation>Dominio: Gestión de Incidentes y Siniestros
Definición: Evento con daño o pérdida que puede activar la cobertura aseguradora.
Ejemplo: Accidente con daños relevantes al casco.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Peritaje" id="bdf7f045-3667-4bf2-8c39-1a7db1e04595">
        <documentation>Dominio: Gestión de Incidentes y Siniestros
Definición: Evaluación especializada exigida para daños superiores al umbral definido.
Ejemplo: Daño superior a COP 5 millones requiere perito.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Reclamación al seguro" id="05366e4d-a0f7-4a96-a445-617b24954866">
        <documentation>Dominio: Gestión de Incidentes y Siniestros
Definición: Solicitud o expediente de cobertura asociado a un siniestro del arriendo.
Ejemplo: Tras validar un daño cubierto, se registra el número de caso y la respuesta de cobertura de la aseguradora.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Tarifa" id="77b80d3e-f0b8-4c5d-ba3a-54674d9f1df7">
        <documentation>Dominio: Tarifación y Cotización
Definición: Valor base aplicable al arriendo antes de recargos y componentes adicionales.
Ejemplo: COP 3.500.000 por día en temporada baja.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Temporada" id="c791d305-b6cd-498f-9e72-78e45502b659">
        <documentation>Dominio: Tarifación y Cotización
Definición: Condición temporal que modifica el precio mediante reglas de recargo.
Ejemplo: Temporada alta aplica recargo del 30 %.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Cotización" id="7f1ed984-d534-432d-9d17-8a70c41ece84">
        <documentation>Dominio: Tarifación y Cotización
Definición: Propuesta económica presentada al cliente con alquiler y estimaciones asociadas.
Ejemplo: Incluye alquiler, seguro estimado, depósito y extras.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Depósito estimado" id="7eee93c5-fa2b-48e3-ae07-ed786e13a833">
        <documentation>Dominio: Tarifación y Cotización
Definición: Valor previsto de garantía calculado para informar al cliente antes de la decisión final de riesgo.
Ejemplo: Se muestra el mayor entre porcentaje y mínimo de categoría.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Contraparte" id="a982dcb8-5d27-4560-9f9a-907b73996459">
        <documentation>Dominio: Admisibilidad y Cumplimiento
Definición: Persona u organización cuya relación con la empresa debe ser conocida y evaluada.
Ejemplo: Cliente, propietario, marina o proveedor relevante.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="PEP" id="86d5afd8-6cc4-4b47-9638-f7cde5c863b5">
        <documentation>Dominio: Admisibilidad y Cumplimiento
Definición: Persona Expuesta Políticamente que exige una revisión reforzada, no rechazo automático.
Ejemplo: Cliente PEP pasa a debida diligencia reforzada.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Beneficiario final" id="393cbedb-9bb2-4c1a-abb2-e87023f41c89">
        <documentation>Dominio: Admisibilidad y Cumplimiento
Definición: Persona natural que controla o se beneficia finalmente de una empresa contraparte.
Ejemplo: En cliente corporativo se identifica el beneficiario final.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Decisión de cumplimiento" id="d5f70ae3-2ed3-4841-83b0-a1b28be7ddb4">
        <documentation>Dominio: Admisibilidad y Cumplimiento
Definición: Resultado que determina si la relación u operación es admisible según políticas y obligaciones.
Ejemplo: Cumplimiento bloquea la operación aunque riesgo la hubiera aprobado.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Posición" id="0c09de96-15a3-4b76-9439-14ed1bc7fcd6">
        <documentation>Dominio: Seguimiento Operacional
Definición: Ubicación autorizada del yate registrada por la plataforma a partir del dispositivo o navegador disponible.
Ejemplo: Durante la navegación se registra la ubicación para validar zona permitida y atender alertas.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Zona permitida" id="8c3ef94e-09ce-440f-8fe1-ae56cdc8b59c">
        <documentation>Dominio: Seguimiento Operacional
Definición: Área autorizada de navegación definida para el yate y la operación.
Ejemplo: Se excluyen áreas restringidas por autoridad.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Combustible" id="a0419ff1-56bb-47d8-ad65-9bc4b778e0ca">
        <documentation>Dominio: Seguimiento Operacional
Definición: Nivel de combustible asociado a la operación y registrado durante entrega, seguimiento o devolución.
Ejemplo: La marina registra el nivel inicial y final para apoyar la liquidación del consumo.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Alerta operacional" id="b0f5fbb4-30cd-4179-b6df-b4d8b81d97fc">
        <documentation>Dominio: Seguimiento Operacional
Definición: Señal calculada o registrada por la plataforma cuando una condición operacional requiere intervención.
Ejemplo: La plataforma genera una alerta por salida de zona permitida o no devolución.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Liquidación" id="2441894a-fb97-454b-adc6-8a91f469d017">
        <documentation>Dominio: Liquidación Económica
Definición: Cálculo final de obligaciones económicas derivadas del arriendo.
Ejemplo: Incluye combustible, retrasos, daños y reparto.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Cargo por retraso" id="af024b6c-f7a7-4d48-96e5-190fabd32a3b">
        <documentation>Dominio: Liquidación Económica
Definición: Importe generado cuando la devolución supera la tolerancia definida.
Ejemplo: Después de una hora se aplica 15 % del valor diario por hora.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Aplicación de depósito" id="d75d7cb9-e89c-4158-af8f-6473d46e01c1">
        <documentation>Dominio: Liquidación Económica
Definición: Decisión de usar total o parcialmente la garantía para cubrir una obligación atribuible al cliente.
Ejemplo: Daño atribuible consume primero el depósito.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Participación 75/25" id="71ac0be0-b6b1-430c-a8e2-158be5bca27e">
        <documentation>Dominio: Liquidación Económica
Definición: Regla de reparto del valor del alquiler entre propietario y empresa.
Ejemplo: 75 % para propietario y 25 % para la empresa.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Calificación" id="37365701-f0b1-440a-bb53-fef831014236">
        <documentation>Dominio: Reputación y Calidad
Definición: Valoración numérica o cualitativa registrada entre las partes al finalizar un arriendo.
Ejemplo: Cliente y propietario registran su valoración al cierre.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Reputación" id="32e73b7c-9a25-442e-a6ef-eea911201f84">
        <documentation>Dominio: Reputación y Calidad
Definición: Historial consolidado de calificaciones y comportamiento que influye en decisiones futuras.
Ejemplo: Una reputación baja puede provocar revisión o bloqueo antes de un nuevo arriendo.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Consecuencia de reputación" id="16c8c09b-96d4-46cf-ada4-1413c047a04f">
        <documentation>Dominio: Reputación y Calidad
Definición: Resultado operativo derivado de los umbrales de calificación y reputación, como seguimiento, revisión, bloqueo o plan de mejora.
Ejemplo: Un cliente con reputación inferior al umbral queda en revisión antes de un nuevo arriendo.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Plan de mejora" id="8a7d3863-4dda-40e2-a969-00174eff9690">
        <documentation>Dominio: Reputación y Calidad
Definición: Conjunto de acciones de mejora asociado al desempeño o reputación de un propietario/yate.
Ejemplo: Un propietario con valoración baja debe cumplir acciones antes de recuperar plena habilitación.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Pago" id="314733ea-f99a-453a-8438-546bdfabc36d">
        <documentation>Dominio: Pagos y Facturación
Definición: Ejecución financiera de un valor adeudado dentro del proceso.
Ejemplo: Anticipo del 40 % al reservar.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Preautorización" id="5dd41ce8-0e0a-4867-bdec-96770c1ff769">
        <documentation>Dominio: Pagos y Facturación
Definición: Reserva de cupo en tarjeta sin custodiar ni capturar inicialmente el dinero.
Ejemplo: Depósito preautorizado 48 horas antes.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Reembolso" id="acdc4971-a87b-496f-a15c-100412388976">
        <documentation>Dominio: Pagos y Facturación
Definición: Devolución de dinero al cliente según reglas de cancelación o suspensión.
Ejemplo: Marina cancela por clima y se devuelve el total.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Factura" id="5cd39a79-d0cb-4231-ab7d-c8a51bed17ca">
        <documentation>Dominio: Pagos y Facturación
Definición: Documento o referencia de facturación generada por el sistema contable/facturador a partir de la información económica enviada por la plataforma.
Ejemplo: Al cierre, la plataforma envía los valores y conserva el identificador devuelto por el sistema contable/facturador.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Indicador" id="6f365c29-b923-4405-b941-2e310c253adb">
        <documentation>Dominio: Analítica y Reportes
Definición: Medida calculada para evaluar desempeño del negocio u operación.
Ejemplo: Tiempo promedio de devolución del depósito.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Ocupación" id="727e9175-995a-44a7-9ced-8a421ce0d7dc">
        <documentation>Dominio: Analítica y Reportes
Definición: Proporción de disponibilidad utilizada en arriendos.
Ejemplo: Promedio anual actual aproximado del 45 %.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Siniestralidad" id="1368d631-04b1-4f60-b3ae-de95fee6048d">
        <documentation>Dominio: Analítica y Reportes
Definición: Medida de frecuencia y/o costo asociado a daños y siniestros.
Ejemplo: Porcentaje de arriendos con daños reportados.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Reporte" id="64f083ff-566f-44e7-ab36-8a95588edb8b">
        <documentation>Dominio: Analítica y Reportes
Definición: Salida consolidada que presenta indicadores para seguimiento y decisión.
Ejemplo: Dashboard por yate, marina, propietario y temporada.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Bloqueo [Gestión de Propietarios y Yates]" id="c4193177-f48b-4b48-ad5c-95d67c247eec">
        <documentation>Término polisémico: Bloqueo
Dominio/contexto: Gestión de Propietarios y Yates
Significado contextual: Estado que impide ofrecer/entregar un yate.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Bloqueo [Admisibilidad y Cumplimiento]" id="621e9e2f-a6a2-4af7-83f5-d2d6edc58b6a">
        <documentation>Término polisémico: Bloqueo
Dominio/contexto: Admisibilidad y Cumplimiento
Significado contextual: Detención de la relación u operación por una restricción de cumplimiento.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Bloqueo [Reputación y Calidad]" id="fe9d0161-f7a6-4e16-b855-a2c8ecf24b12">
        <documentation>Término polisémico: Bloqueo
Dominio/contexto: Reputación y Calidad
Significado contextual: Restricción aplicada a cliente/propietario por umbrales de reputación.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Aprobación [Decisión de Riesgo del Arrendamiento]" id="9ad95868-ae33-4336-a53a-63e3733d0fe1">
        <documentation>Término polisémico: Aprobación
Dominio/contexto: Decisión de Riesgo del Arrendamiento
Significado contextual: Aceptación del nivel de riesgo del arriendo, con o sin condiciones.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Aprobación [Admisibilidad y Cumplimiento]" id="64044333-7fb4-42af-b2f4-f13e4558a8af">
        <documentation>Término polisémico: Aprobación
Dominio/contexto: Admisibilidad y Cumplimiento
Significado contextual: Determinación de que la operación es admisible desde políticas/obligaciones.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Depósito [Decisión de Riesgo del Arrendamiento]" id="33747d81-cc74-48f6-9cfd-f5569880a758">
        <documentation>Término polisémico: Depósito
Dominio/contexto: Decisión de Riesgo del Arrendamiento
Significado contextual: Mecanismo de mitigación cuyo monto puede aumentarse.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Depósito [Pagos y Facturación]" id="b192d69a-9d08-47c4-9374-893fb4e14a50">
        <documentation>Término polisémico: Depósito
Dominio/contexto: Pagos y Facturación
Significado contextual: Preautorización financiera ejecutada en tarjeta.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Depósito [Liquidación Económica]" id="ed0d0d97-e057-4935-a570-e496576fe7fe">
        <documentation>Término polisémico: Depósito
Dominio/contexto: Liquidación Económica
Significado contextual: Garantía que se libera, retiene o aplica al cierre.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Póliza [Gestión de Propietarios y Yates]" id="cfc30287-5de3-4ffe-acdf-4918ed8aab68">
        <documentation>Término polisémico: Póliza
Dominio/contexto: Gestión de Propietarios y Yates
Significado contextual: Póliza anual del propietario, requisito de habilitación.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Póliza [Gestión del Arrendamiento]" id="91d06e3a-64c9-43f3-b1cf-61750410e48d">
        <documentation>Término polisémico: Póliza
Dominio/contexto: Gestión del Arrendamiento
Significado contextual: Póliza por arriendo emitida para una operación concreta.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Póliza [Gestión de Incidentes y Siniestros]" id="db22501d-3dc9-4404-8480-402d66f5f243">
        <documentation>Término polisémico: Póliza
Dominio/contexto: Gestión de Incidentes y Siniestros
Significado contextual: Cobertura que se activa frente a un daño/siniestro.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Alerta [Seguimiento Operacional]" id="f9f878b9-4848-40a7-bfb7-61bf71b109d6">
        <documentation>Término polisémico: Alerta
Dominio/contexto: Seguimiento Operacional
Significado contextual: Señal por desviación de zona, combustible u otra condición operativa.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Alerta [Admisibilidad y Cumplimiento]" id="c5182788-830c-4fe4-937a-f3ed17690d50">
        <documentation>Término polisémico: Alerta
Dominio/contexto: Admisibilidad y Cumplimiento
Significado contextual: Señal que exige revisión por cumplimiento.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Alerta [Decisión de Riesgo del Arrendamiento]" id="7d163840-03fd-4765-bd08-c22805025bc9">
        <documentation>Término polisémico: Alerta
Dominio/contexto: Decisión de Riesgo del Arrendamiento
Significado contextual: Señal o recomendación externa que alimenta la decisión.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Revisión [Admisibilidad y Cumplimiento]" id="be4d8950-1ba5-4354-9e40-0c939a78b3dd">
        <documentation>Término polisémico: Revisión
Dominio/contexto: Admisibilidad y Cumplimiento
Significado contextual: Análisis reforzado por PEP, listas u otra señal de cumplimiento.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Revisión [Reputación y Calidad]" id="28c54f4b-201c-4abc-bb8b-05b0e5c03dad">
        <documentation>Término polisémico: Revisión
Dominio/contexto: Reputación y Calidad
Significado contextual: Estado aplicado a cliente con umbrales bajos de calificación.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Elegibilidad del arrendatario" id="id-04691fbdac5144a3b4094256412ba14d">
        <documentation>Dominio: Gestión del Arrendamiento
Definición: Resultado de validar los requisitos mínimos del arrendatario antes de continuar: edad, identificación y licencia/experiencia; puede determinar capitán obligatorio.
Ejemplo: Cliente mayor de 25 años sin experiencia suficiente: elegible con capitán obligatorio.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Contrato de arriendo" id="id-a8b548980e0742b3b61a5e31f516eee1">
        <documentation>Dominio: Gestión del Arrendamiento
Definición: Documento generado y conservado por la plataforma que formaliza las condiciones del arriendo aceptadas por las partes.
Ejemplo: La plataforma genera el contrato, registra su aceptación y conserva el documento con trazabilidad.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Yate" id="id-aeb66e57e0ba475da32d86b8af6a87a3">
        <documentation>Dominio: Gestión de Propietarios y Yates
Definición: Embarcación de un tercero administrada comercial y operacionalmente por la empresa bajo condiciones de habilitación.
Ejemplo: Yate de 45 pies asociado a un propietario y una marina, con documentación y póliza anual vigentes.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Marina" id="id-037e4857e28e436bb472574e76e2814f">
        <documentation>Dominio: Gestión de Marinas y Operación Náutica
Definición: Actor externo que ejecuta alistamiento, entrega, recepción, combustible e inspección y que usa directamente la plataforma en esta versión.
Ejemplo: El operador de marina confirma el alistamiento y registra el acta de entrega en la aplicación.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Capitán independiente" id="id-cf45dbad5a8b4df69639280c67350f6d">
        <documentation>Dominio: Gestión de Marinas y Operación Náutica
Definición: Prestador externo coordinado por la empresa cuando es obligatorio o seleccionado; su disponibilidad y asignación se registran en la plataforma.
Ejemplo: Para un yate mayor de 50 pies se asigna un capitán disponible del maestro F5.</documentation>
      </element>
      <element xsi:type="archimate:Representation" name="Servicio complementario registrado" id="id-3d8f04593a8a4793a64a4c6f366880ec">
        <documentation>Dominio: Gestión del Arrendamiento
Definición: Selección u observación asociada a la reserva para un servicio complementario distinto del capitán, sin ciclo de gestión propio en esta versión.
Ejemplo: La reserva registra que el cliente solicita catering, sin administrar proveedor, pago ni asignación.</documentation>
      </element>
    </folder>
    <folder name="Fase 5 - Business - Actores externos Fase 5" id="id-a46fb51a0b4f491886c4db98c5af5605">
      <element xsi:type="archimate:BusinessActor" name="Autoridades marítimas: DIMAR y capitanías (externo)" id="id-616af82eab6346d1940473d42c3b71c6">
        <documentation>Externo: Autoridades marítimas (DIMAR y capitanías de puerto). No lo construimos; solo nos integramos a través de A09 Interfaz con autoridades marítimas.</documentation>
        <property key="Tipo" value="Externo"/>
        <property key="Tipo de externo" value="Entidad regulatoria"/>
        <property key="Externo" value="Autoridades marítimas (DIMAR y capitanías de puerto)"/>
        <property key="Patrón hoy" value="Caminos separados (sin integración automática en esta versión)"/>
        <property key="Patrón si se automatiza" value="ACL"/>
        <property key="Contexto que lo cubre" value="Gestión de Incidentes y Siniestros"/>
      </element>
      <element xsi:type="archimate:BusinessRole" name="Perito de daños (externo)" id="id-98a372a5d466401492bbbb3be88503cc">
        <documentation>Externo: Peritos de daños. No lo construimos; solo nos integramos a través de A12 Interfaz con peritos.</documentation>
        <property key="Tipo" value="Externo"/>
        <property key="Tipo de externo" value="Proveedor externo"/>
        <property key="Externo" value="Peritos de daños"/>
        <property key="Patrón hoy" value="Caminos separados (sin integración automática en esta versión)"/>
        <property key="Patrón si se automatiza" value="ACL"/>
        <property key="Contexto que lo cubre" value="Gestión de Incidentes y Siniestros"/>
      </element>
      <element xsi:type="archimate:BusinessActor" name="Red de capitanes independientes (externo)" id="id-a67ab9bb80bd42acac36ca2a39a73249">
        <documentation>Externo: Red de capitanes independientes. No lo construimos; solo nos integramos a través de A11 Interfaz con la red de capitanes.</documentation>
        <property key="Tipo" value="Externo"/>
        <property key="Tipo de externo" value="Proveedor externo"/>
        <property key="Externo" value="Red de capitanes independientes"/>
        <property key="Patrón hoy" value="Caminos separados (sin integración automática en esta versión)"/>
        <property key="Patrón si se automatiza" value="ACL"/>
        <property key="Contexto que lo cubre" value="Gestión de Marinas y Operación Náutica"/>
      </element>
      <element xsi:type="archimate:BusinessActor" name="Marinas aliadas (externo)" id="id-e4ca1b393d1e4a419ec0a4d578eae8bd">
        <documentation>Externo: Marinas aliadas. No lo construimos; solo nos integramos a través de A06 Portal de marina (acceso directo).</documentation>
        <property key="Tipo" value="Externo"/>
        <property key="Tipo de externo" value="Proveedor externo (6 hoy, 10 meta)"/>
        <property key="Externo" value="Marinas aliadas"/>
        <property key="Patrón hoy" value="Caminos separados (sin integración automática en esta versión)"/>
        <property key="Patrón si se automatiza" value="OHS: portal de marina (acceso directo)"/>
        <property key="Contexto que lo cubre" value="Gestión de Marinas y Operación Náutica"/>
      </element>
    </folder>
    <folder name="Fase 6 - Business - Fase 6" id="id-2b70af29c0b545a2a1599050d2c4f898">
      <element xsi:type="archimate:Representation" name="Solicitud de reserva" id="id-7209f65f581f4612a1b46887a098bd8a">
        <documentation>Término principal del lenguaje ubicuo de Gestión del Arrendamiento, reutilizado en V11 con la misma convención semántica empleada en V7.</documentation>
        <property key="Uso" value="Lenguaje ubicuo - Canvas V11"/>
      </element>
      <element xsi:type="archimate:Representation" name="Reserva" id="id-b20157bc29d742ee872a7b6f030a7e4e">
        <documentation>Término principal del lenguaje ubicuo de Gestión del Arrendamiento, reutilizado en V11 con la misma convención semántica empleada en V7.</documentation>
        <property key="Uso" value="Lenguaje ubicuo - Canvas V11"/>
      </element>
      <element xsi:type="archimate:Representation" name="Arriendo" id="id-2e5fe7f9a9d245caa2706651b5a1b1a7">
        <documentation>Término principal del lenguaje ubicuo de Gestión del Arrendamiento, reutilizado en V11 con la misma convención semántica empleada en V7.</documentation>
        <property key="Uso" value="Lenguaje ubicuo - Canvas V11"/>
      </element>
      <element xsi:type="archimate:Representation" name="Contrato de arriendo" id="id-2e558573e85448ed86bd1b061639e3a3">
        <documentation>Término principal del lenguaje ubicuo de Gestión del Arrendamiento, reutilizado en V11 con la misma convención semántica empleada en V7.</documentation>
        <property key="Uso" value="Lenguaje ubicuo - Canvas V11"/>
      </element>
      <element xsi:type="archimate:Representation" name="Elegibilidad del arrendatario" id="id-e1e5cc60f2cf4b42bab28c4cb480c8b3">
        <documentation>Término principal del lenguaje ubicuo de Gestión del Arrendamiento, reutilizado en V11 con la misma convención semántica empleada en V7.</documentation>
        <property key="Uso" value="Lenguaje ubicuo - Canvas V11"/>
      </element>
      <element xsi:type="archimate:Representation" name="Depósito" id="id-a2502d20e0ca4b319ccf66245f1fab9c">
        <documentation>Término principal del lenguaje ubicuo de Gestión del Arrendamiento, reutilizado en V11 con la misma convención semántica empleada en V7.</documentation>
        <property key="Uso" value="Lenguaje ubicuo - Canvas V11"/>
      </element>
      <element xsi:type="archimate:Representation" name="Cancelación" id="id-b2674f597b074c51beb7d1b6a459aa9b">
        <documentation>Término principal del lenguaje ubicuo de Gestión del Arrendamiento, reutilizado en V11 con la misma convención semántica empleada en V7.</documentation>
        <property key="Uso" value="Lenguaje ubicuo - Canvas V11"/>
      </element>
      <element xsi:type="archimate:Representation" name="Cierre del arriendo" id="id-510d2931c97741a5ba2c28ccd49b1e5d">
        <documentation>Término principal del lenguaje ubicuo de Gestión del Arrendamiento, reutilizado en V11 con la misma convención semántica empleada en V7.</documentation>
        <property key="Uso" value="Lenguaje ubicuo - Canvas V11"/>
      </element>
    </folder>
    <element xsi:type="archimate:BusinessProcess" name="Proceso E2E de arrendamiento" id="id-cd3d8ab9a5944a3b84cfe0930fd74c9e">
      <documentation>Proceso de punta a punta: empieza en la captación y termina cuando el depósito se devuelve o se retiene y el propietario recibe su pago (72 horas después de un cierre sin novedades).</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Captar clientes y gestionar la relación comercial" id="id-02077eed939948eda848663cb76787a6">
      <property key="Cubierto por la aplicación" value="Sin impacto directo"/>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Buscar yates y cotizar" id="id-83cba7fccfe3485d9095d82f87a5f132">
      <documentation>Consulta por marina, fechas y personas; produce cotización con alquiler, seguro estimado y depósito.</documentation>
      <property key="Cubierto por la aplicación" value="Impacta (alta)"/>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Evaluar el riesgo del cliente" id="id-440eed4452b44971958f0f490cd47a9f">
      <documentation>Evaluador externo (resultado en menos de 15 min; casos dudosos hasta 24 h). Decide el área de riesgos: aprobado, aprobado con condiciones o rechazado.</documentation>
      <property key="Cubierto por la aplicación" value="Impacta (alta)"/>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Reservar, contratar y asegurar" id="id-c4c3c515204d46b985205deca5ecbaf6">
      <documentation>Pago inicial del 40%; contrato firmado electrónicamente; póliza del arriendo; notificación a propietario y marina.</documentation>
      <property key="Cubierto por la aplicación" value="Impacta (alta)"/>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Preparar el yate" id="id-c8b4ef49d05240c2aac8eba1df92bffa">
      <documentation>La marina prepara el yate 48 h antes con lista de verificación; saldo del 60% siete días antes; depósito pre-autorizado 48 h antes.</documentation>
      <property key="Cubierto por la aplicación" value="Impacta (alta)"/>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Entregar el yate" id="id-6622bbeb9757449fb0b7e76f806b03f1">
      <documentation>Acta de entrega con fotos, nivel de combustible y estado general; yate con tanque lleno.</documentation>
      <property key="Cubierto por la aplicación" value="Impacta (alta)"/>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Monitorear la navegación" id="id-cdca3b74109c49b293ccf944e2eee49f">
      <documentation>Seguimiento de ubicación y combustible visible para marina y cliente; alarma al salir de la zona.</documentation>
      <property key="Cubierto por la aplicación" value="Impacta (alta)"/>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Recibir e inspeccionar el yate" id="id-7f54d81c26f749c0ab2fd8e3b8446c15">
      <documentation>Inspección conjunta marina–cliente; informe de inspección en 24 h; el propietario puede objetar en 48 h.</documentation>
      <property key="Cubierto por la aplicación" value="Impacta (alta)"/>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Cerrar el arriendo y ajustar los pagos" id="id-8833124e2bb74db7a154c64c69d9b9f1">
      <documentation>Liquida combustible al precio de surtidor del día; decide devolución o retención del depósito (5 días hábiles hoy).</documentation>
      <property key="Cubierto por la aplicación" value="Impacta (alta)"/>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Calificar mutuamente a cliente y propietario" id="id-684422b733e940adb818f2390365d696">
      <documentation>Calificaciones mutuas; cliente con menos de 3,5 en tres arriendos pasa a revisión.</documentation>
      <property key="Cubierto por la aplicación" value="Impacta (alta)"/>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Liquidar y pagar a propietarios y marinas" id="id-f5a5230557334c089ffd78d07bbba66a">
      <documentation>75% al propietario, 25% a la empresa y pago por servicio a la marina, 72 h después de un cierre sin novedades.</documentation>
      <property key="Cubierto por la aplicación" value="Impacta (parcial)"/>
    </element>
    <element xsi:type="archimate:BusinessEvent" name="Cliente busca un yate" id="id-3c0515bb07854e8eaa2322e0b05eba79"/>
    <element xsi:type="archimate:BusinessEvent" name="Cliente inicia la reserva" id="id-c2d4dac61363474197ca010d73af242d"/>
    <element xsi:type="archimate:BusinessEvent" name="Reserva confirmada con pago inicial del 40%" id="id-9fd9ae1271f24eaba029716d0d7cb9a8"/>
    <element xsi:type="archimate:BusinessEvent" name="Llega la fecha y hora de entrega" id="id-c4793014736a430c8bf3fa7cc56472e0"/>
    <element xsi:type="archimate:BusinessEvent" name="Cliente devuelve el yate a la marina" id="id-4ae606ebdb934339a081be52a895da15"/>
    <element xsi:type="archimate:BusinessEvent" name="Informe de inspección emitido (24 h)" id="id-7cc276bb1aba468fa610160025988660"/>
    <element xsi:type="archimate:BusinessEvent" name="Arriendo cerrado sin novedades" id="id-8867e7d9b0b74a05bcf36b14d3c185dc"/>
    <element xsi:type="archimate:BusinessEvent" name="Pasan 72 horas desde el cierre" id="id-6e9886cfd7d144fca15ab6dcc0f46132"/>
    <element xsi:type="archimate:BusinessActor" name="Cliente (arrendatario)" id="id-e2ff27bdd8f24233ac528163b48bcdea"/>
    <element xsi:type="archimate:BusinessActor" name="Evaluador de riesgo (externo)" id="id-85043a2d7850418f91fe5da9829dbcb9"/>
    <element xsi:type="archimate:BusinessActor" name="Área de riesgos de la empresa" id="id-597ae38e9f6d4829bcaad3c714f9def3"/>
    <element xsi:type="archimate:BusinessActor" name="Aseguradora" id="id-fecfb43007f54526b46e2fabeda7aded"/>
    <element xsi:type="archimate:BusinessActor" name="Pasarela de pagos" id="id-528b1cd9e636476db70f76cf093a4766"/>
    <element xsi:type="archimate:BusinessActor" name="Marina" id="id-eb658f07af2746ef81ee62ec59efdbb9"/>
    <element xsi:type="archimate:BusinessActor" name="Capitán" id="id-56af103d4c1e4f668a68528972abb44a"/>
    <element xsi:type="archimate:BusinessActor" name="Propietario del yate" id="id-7adc83a69ad44351aeaff5a2ada61ba3"/>
    <element xsi:type="archimate:BusinessActor" name="Equipo de flota y propietarios" id="id-a637ed478f6d48bf9c71898aae533382">
      <property key="Tipo" value="Equipo interno"/>
      <property key="Fase" value="2"/>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Equipo de reservas" id="id-5e0bc7f65fa544aa8590bf318e062cba">
      <property key="Tipo" value="Equipo interno"/>
      <property key="Fase" value="2"/>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Centro de monitoreo" id="id-6bc3c1fe2f7441f091d34c41263a97d1">
      <property key="Tipo" value="Equipo interno"/>
      <property key="Fase" value="2"/>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Equipo de tesorería" id="id-17295fe27bbf435d88c914d3fedbaa91">
      <property key="Tipo" value="Equipo interno"/>
      <property key="Fase" value="2"/>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Proveedor de seguimiento" id="id-2dea1cea9e1d4099bb8ce575397f1041">
      <property key="Tipo" value="Dispositivo y proveedor externo"/>
      <property key="Fase" value="2"/>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Autoridades marítimas (DIMAR y capitanías)" id="id-6a6be0914a31466a85647b9bea1a0798">
      <property key="Tipo" value="Entidad regulatoria"/>
      <property key="Fase" value="2"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="P1 Disponibilidad y habilitación de flota" id="id-7ca2ad87c37a4a288df1df7df45aa972">
      <documentation>Mantiene qué yates se pueden arrendar y cuándo.</documentation>
      <property key="Capa" value="2 - Servicio de plataforma"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Es la base de la oferta: sin yates habilitados y vigentes no hay arriendo. Concentra la regla «si está habilitado, está disponible»."/>
      <property key="Fuente" value="Entrevista §2; Fase 1 (V3)"/>
      <property key="Capacidad" value="Habilitación y bloqueo de yates; Gestión del inventario de yates por marina; Gestión de documentación y certificados del yate"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="P2 Cotización y reserva de arriendos" id="id-cfa7b858ba984edb83afecd05fc9464e">
      <documentation>Convierte una búsqueda en una reserva confirmada con contrato.</documentation>
      <property key="Capa" value="2 - Servicio de plataforma"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Cubre los procesos «Buscar yates y cotizar» y «Reservar, contratar y asegurar» de V3; es el servicio que ven clientes, agencias y hoteles."/>
      <property key="Fuente" value="Entrevista §2; Fase 1 (V3)"/>
      <property key="Capacidad" value="Consulta y cotización de yates; Gestión de reservas; Gestión de tarifas y temporadas"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="P3 Evaluación y aseguramiento del arriendo" id="id-b4326684e84b49168374def96210de8d">
      <documentation>Decide si se arrienda y bajo qué condiciones, y deja el arriendo asegurado.</documentation>
      <property key="Capa" value="2 - Servicio de plataforma"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Es el valor principal del negocio (gestión del riesgo, entrevista §1); por eso es una plataforma propia."/>
      <property key="Fuente" value="Entrevista §2; Fase 1 (V3)"/>
      <property key="Capacidad" value="Evaluación de riesgo del cliente; Gestión de seguros"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="P4 Operación del yate en marina" id="id-b9c351167791489cb47e8c2e94b1b537">
      <documentation>Alistamiento, entrega, recepción e inspección, y gestión de daños e incidentes.</documentation>
      <property key="Capa" value="2 - Servicio de plataforma"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Agrupa lo que ocurre físicamente en la marina; hoy es la fuente de errores por WhatsApp (entrevista §8)."/>
      <property key="Fuente" value="Entrevista §2; Fase 1 (V3)"/>
      <property key="Capacidad" value="Alistamiento y entrega del yate; Recepción e inspección del yate; Coordinación operativa con marinas; Gestión de capitanes; Gestión de incidentes y siniestros; Gestión del desempeño e indicadores"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="P5 Seguimiento de la navegación" id="id-0b1884eb60244cf3aeb245881ae6bcb4">
      <documentation>Vigila ubicación y combustible durante el arriendo y reacciona a alarmas.</documentation>
      <property key="Capa" value="2 - Servicio de plataforma"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Habilita el control del riesgo en el agua; depende del dispositivo y de la conectividad (límite de ~12 millas)."/>
      <property key="Fuente" value="Entrevista §2; Fase 1 (V3)"/>
      <property key="Capacidad" value="Seguimiento de ubicación y combustible; Control de zona permitida y alertas; Gestión de incidentes y siniestros"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="P6 Cierre, cobro y liquidación" id="id-6882baa49c6947899b220dcf6f71df8b">
      <documentation>Cobros, depósito, cierre del arriendo y pagos a propietarios y marinas.</documentation>
      <property key="Capa" value="2 - Servicio de plataforma"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Respalda las metas de cierre en 3 días hábiles y devolución de depósito; los cobros se usan de forma transversal en el proceso."/>
      <property key="Fuente" value="Entrevista §2; Fase 1 (V3)"/>
      <property key="Capacidad" value="Cobro y conciliación de pagos del arriendo; Gestión de depósitos de garantía; Ajustes de cierre (combustible y depósito); Liquidación y pago a propietarios y marinas"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="P7 Reputación y calidad" id="id-6ad7f301d1f840e3ac07be795968c0fe">
      <documentation>Calificaciones mutuas y sus consecuencias.</documentation>
      <property key="Capa" value="2 - Servicio de plataforma"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Cierra el ciclo de confianza entre cliente y propietario y alimenta la evaluación de riesgo."/>
      <property key="Fuente" value="Entrevista §2; Fase 1 (V3)"/>
      <property key="Capacidad" value="Calificaciones mutuas cliente–propietario"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="G1 Gestión de flota y disponibilidad" id="id-3f9af819579c4c169a6574798bbf26d7">
      <documentation>Agrupa S01 a S04, que mantienen la oferta que usa «Buscar yates y cotizar»: consultar, habilitar o bloquear, reubicar y validar vigencias. Comparten el maestro de yates (F3) y un mismo responsable, el equipo de flota.</documentation>
      <property key="Capa" value="3 - Servicio de gestión"/>
      <property key="Plataforma" value="P1"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Agrupa S01 a S04, que mantienen la oferta que usa «Buscar yates y cotizar»: consultar, habilitar o bloquear, reubicar y validar vigencias. Comparten el maestro de yates (F3) y un mismo responsable, el equipo de flota."/>
      <property key="Nota" value="Agrupador de la Fase 2; insumo para la Fase 3 (Pareja 2), no su respuesta."/>
      <property key="Fuente" value="Entrevista §3 y §9"/>
      <property key="Capacidad" value="Habilitación y bloqueo de yates; Gestión del inventario de yates por marina; Gestión de documentación y certificados del yate"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="G2 Gestión de reservas y tarifas" id="id-74ed0c2a44394ab790db153768f6b39a">
      <documentation>Agrupa S05 a S08, los pasos de «Buscar yates y cotizar» y «Reservar, contratar y asegurar» que dependen de las mismas tarifas, temporadas y políticas (F6): cotizar, reservar, cancelar y notificar.</documentation>
      <property key="Capa" value="3 - Servicio de gestión"/>
      <property key="Plataforma" value="P2"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Agrupa S05 a S08, los pasos de «Buscar yates y cotizar» y «Reservar, contratar y asegurar» que dependen de las mismas tarifas, temporadas y políticas (F6): cotizar, reservar, cancelar y notificar."/>
      <property key="Nota" value="Agrupador de la Fase 2; insumo para la Fase 3 (Pareja 2), no su respuesta."/>
      <property key="Fuente" value="Entrevista §3 y §9"/>
      <property key="Capacidad" value="Consulta y cotización de yates; Gestión de reservas; Gestión de tarifas y temporadas"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="G3 Gestión del riesgo del cliente" id="id-f7085d0817954a798a10627bbd2c04c7">
      <documentation>Agrupa S09 a S11, la etapa «Evaluar el riesgo del cliente»: pedir la evaluación, decidir y fijar condiciones. Va aparte porque la decisión es crítica e indelegable (entrevista §9): el evaluador recomienda y la empresa decide.</documentation>
      <property key="Capa" value="3 - Servicio de gestión"/>
      <property key="Plataforma" value="P3"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Agrupa S09 a S11, la etapa «Evaluar el riesgo del cliente»: pedir la evaluación, decidir y fijar condiciones. Va aparte porque la decisión es crítica e indelegable (entrevista §9): el evaluador recomienda y la empresa decide."/>
      <property key="Nota" value="Agrupador de la Fase 2; insumo para la Fase 3 (Pareja 2), no su respuesta."/>
      <property key="Fuente" value="Entrevista §3 y §9"/>
      <property key="Capacidad" value="Evaluación de riesgo del cliente"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="G4 Gestión de seguros" id="id-f58c00b9601f4abe960be29cfe675b0e">
      <documentation>Agrupa S12 y S13, lo que se tramita con la aseguradora (A04): emitir la póliza en «Reservar, contratar y asegurar» y reportar el siniestro al cierre. Sin póliza el proceso se detiene.</documentation>
      <property key="Capa" value="3 - Servicio de gestión"/>
      <property key="Plataforma" value="P3"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Agrupa S12 y S13, lo que se tramita con la aseguradora (A04): emitir la póliza en «Reservar, contratar y asegurar» y reportar el siniestro al cierre. Sin póliza el proceso se detiene."/>
      <property key="Nota" value="Agrupador de la Fase 2; insumo para la Fase 3 (Pareja 2), no su respuesta."/>
      <property key="Fuente" value="Entrevista §3 y §9"/>
      <property key="Capacidad" value="Gestión de seguros"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="G5 Gestión de operación en marina" id="id-a71f2206527c4cc3b1fd768e35947625">
      <documentation>Agrupa S14 a S18, las actividades físicas de la marina y el capitán en «Preparar el yate», «Entregar el yate» y «Recibir e inspeccionar el yate». Todas dependen de la integración con marinas (A06), la más crítica (entrevista §8).</documentation>
      <property key="Capa" value="3 - Servicio de gestión"/>
      <property key="Plataforma" value="P4"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Agrupa S14 a S18, las actividades físicas de la marina y el capitán en «Preparar el yate», «Entregar el yate» y «Recibir e inspeccionar el yate». Todas dependen de la integración con marinas (A06), la más crítica (entrevista §8)."/>
      <property key="Nota" value="Agrupador de la Fase 2; insumo para la Fase 3 (Pareja 2), no su respuesta."/>
      <property key="Fuente" value="Entrevista §3 y §9"/>
      <property key="Capacidad" value="Alistamiento y entrega del yate; Recepción e inspección del yate; Coordinación operativa con marinas; Gestión de capitanes"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="G6 Gestión del seguimiento y emergencias" id="id-511d80f99aa247f6853afd6578ca2e94">
      <documentation>Agrupa S19, S20 y S31, lo que ocurre durante «Monitorear la navegación»: registrar posición, atender alertas y responder emergencias. Comparten el flujo continuo de datos (cada 30 s) y la atención 24/7.</documentation>
      <property key="Capa" value="3 - Servicio de gestión"/>
      <property key="Plataforma" value="P5"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Agrupa S19, S20 y S31, lo que ocurre durante «Monitorear la navegación»: registrar posición, atender alertas y responder emergencias. Comparten el flujo continuo de datos (cada 30 s) y la atención 24/7."/>
      <property key="Nota" value="Agrupador de la Fase 2; insumo para la Fase 3 (Pareja 2), no su respuesta."/>
      <property key="Fuente" value="Entrevista §3 y §9"/>
      <property key="Capacidad" value="Seguimiento de ubicación y combustible; Control de zona permitida y alertas; Gestión de incidentes y siniestros"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="G7 Gestión de pagos y depósitos" id="id-8ab9e49becfe41b5af52ba74472b08b3">
      <documentation>Agrupa S21 a S24, los movimientos de dinero con la pasarela (A07) a lo largo del proceso: cobro 40/60, depósito, combustible y retrasos, y reembolsos. Comparten las reglas de dinero.</documentation>
      <property key="Capa" value="3 - Servicio de gestión"/>
      <property key="Plataforma" value="P6"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Agrupa S21 a S24, los movimientos de dinero con la pasarela (A07) a lo largo del proceso: cobro 40/60, depósito, combustible y retrasos, y reembolsos. Comparten las reglas de dinero."/>
      <property key="Nota" value="Agrupador de la Fase 2; insumo para la Fase 3 (Pareja 2), no su respuesta."/>
      <property key="Fuente" value="Entrevista §3 y §9"/>
      <property key="Capacidad" value="Cobro y conciliación de pagos del arriendo; Gestión de depósitos de garantía"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="G8 Gestión del cierre y liquidaciones" id="id-b07f9d9c953645c5a3bf5427a5f817a8">
      <documentation>Agrupa S25 y S26, las etapas «Cerrar el arriendo y ajustar los pagos» y «Liquidar y pagar a propietarios y marinas»: consolidar el resultado y repartir el dinero (75/25 y pago a la marina).</documentation>
      <property key="Capa" value="3 - Servicio de gestión"/>
      <property key="Plataforma" value="P6"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Agrupa S25 y S26, las etapas «Cerrar el arriendo y ajustar los pagos» y «Liquidar y pagar a propietarios y marinas»: consolidar el resultado y repartir el dinero (75/25 y pago a la marina)."/>
      <property key="Nota" value="Agrupador de la Fase 2; insumo para la Fase 3 (Pareja 2), no su respuesta."/>
      <property key="Fuente" value="Entrevista §3 y §9"/>
      <property key="Capacidad" value="Ajustes de cierre (combustible y depósito); Liquidación y pago a propietarios y marinas"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="G9 Gestión de siniestros y daños" id="id-8da5c9d209804cfeb896daa99701c43d">
      <documentation>Agrupa S27 a S30, lo que sigue a un daño detectado en «Recibir e inspeccionar el yate»: valorar, cobrar, atender la objeción del propietario y medir la siniestralidad, que hoy no se mide bien (entrevista §6).</documentation>
      <property key="Capa" value="3 - Servicio de gestión"/>
      <property key="Plataforma" value="P4"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Agrupa S27 a S30, lo que sigue a un daño detectado en «Recibir e inspeccionar el yate»: valorar, cobrar, atender la objeción del propietario y medir la siniestralidad, que hoy no se mide bien (entrevista §6)."/>
      <property key="Nota" value="Agrupador de la Fase 2; insumo para la Fase 3 (Pareja 2), no su respuesta."/>
      <property key="Fuente" value="Entrevista §3 y §9"/>
      <property key="Capacidad" value="Gestión de incidentes y siniestros; Gestión del desempeño e indicadores"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="G10 Gestión de la reputación" id="id-5d545f5f409248f0b2aedfd5f3b01675">
      <documentation>Agrupa S32 y S33, la etapa «Calificar mutuamente a cliente y propietario»: registrar la calificación y aplicar sus umbrales (3,5 / 3,0 en clientes; 4,0 / 3,5 en propietarios).</documentation>
      <property key="Capa" value="3 - Servicio de gestión"/>
      <property key="Plataforma" value="P7"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Agrupa S32 y S33, la etapa «Calificar mutuamente a cliente y propietario»: registrar la calificación y aplicar sus umbrales (3,5 / 3,0 en clientes; 4,0 / 3,5 en propietarios)."/>
      <property key="Nota" value="Agrupador de la Fase 2; insumo para la Fase 3 (Pareja 2), no su respuesta."/>
      <property key="Fuente" value="Entrevista §3 y §9"/>
      <property key="Capacidad" value="Calificaciones mutuas cliente–propietario"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="S01 Consultar disponibilidad de yates" id="id-af97b40e97824d258f0507a1ea1056fe">
      <documentation>Lista los yates libres por marina, fechas y personas.</documentation>
      <property key="Capa" value="4 - Servicio básico"/>
      <property key="Servicio de gestión" value="G1"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Dispara el proceso («Cliente busca un yate») y cubre el requisito de inventario por marina. Lo consumen web, agencias y marinas, por eso es un servicio reutilizable."/>
      <property key="Fuente" value="Entrevista §2, §3; Fase 1 (requisito de inventario)"/>
      <property key="Capacidad" value="Gestión del inventario de yates por marina; Consulta y cotización de yates"/>
      <property key="Requisito" value="Inventario de yates consultable por la marina más cercana"/>
      <property key="Etapa E2E" value="Buscar yates y cotizar"/>
      <property key="Rol que lo usa" value="Arrendatario"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="S02 Habilitar o bloquear yate" id="id-92d657af77d548de8d0774afd3da5ecd">
      <documentation>Cambia la habilitación del yate por decisión del propietario o de la empresa.</documentation>
      <property key="Capa" value="4 - Servicio básico"/>
      <property key="Servicio de gestión" value="G1"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Es el requisito «habilitación y bloqueo» de la Fase 1; el propietario no aprueba reserva por reserva, así que esta decisión debe ser explícita y trazable."/>
      <property key="Fuente" value="Entrevista §1, §4"/>
      <property key="Capacidad" value="Habilitación y bloqueo de yates"/>
      <property key="Requisito" value="Habilitación y bloqueo del yate por su propietario"/>
      <property key="Etapa E2E" value="Previo al E2E: gestión de la oferta (alimenta «Buscar yates y cotizar»)"/>
      <property key="Rol que lo usa" value="Propietario del yate"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="S03 Reubicar cliente en yate equivalente" id="id-5154ac2a06594895b7a214bc42df2002">
      <documentation>Reasigna al cliente cuando el propietario bloquea un yate ya reservado.</documentation>
      <property key="Capa" value="4 - Servicio básico"/>
      <property key="Servicio de gestión" value="G1"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Regla explícita de la entrevista (§4); evita que la penalización al propietario se traduzca en pérdida del cliente."/>
      <property key="Fuente" value="Entrevista §4"/>
      <property key="Capacidad" value="Gestión de reservas"/>
      <property key="Etapa E2E" value="Retroceso: bloqueo del propietario sobre una reserva confirmada (entre «Reservar» y «Entregar»)"/>
      <property key="Rol que lo usa" value="Ejecutivo de reservas"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="S04 Validar documentación y seguros del yate" id="id-864a8c89e3a34a3caf83663656b3cdc2">
      <documentation>Verifica matrícula, certificados DIMAR y póliza anual vigentes.</documentation>
      <property key="Capa" value="4 - Servicio básico"/>
      <property key="Servicio de gestión" value="G1"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="La norma marítima (DIMAR) y la política de seguros lo exigen; es causa de bloqueo por la empresa (entrevista §4 y §7)."/>
      <property key="Fuente" value="Entrevista §4, §7"/>
      <property key="Capacidad" value="Gestión de documentación y certificados del yate"/>
      <property key="Etapa E2E" value="Previo al E2E: vigencia de la oferta"/>
      <property key="Rol que lo usa" value="Gestor de flota"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="S05 Cotizar arriendo" id="id-8e0f199811174b5e834098530c11f01d">
      <documentation>Calcula alquiler, seguro estimado y depósito.</documentation>
      <property key="Capa" value="4 - Servicio básico"/>
      <property key="Servicio de gestión" value="G2"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Produce la cotización de la etapa «Buscar yates y cotizar» y concentra las reglas de precio, que hoy deben ser iguales para todos los canales."/>
      <property key="Fuente" value="Entrevista §2, §4"/>
      <property key="Capacidad" value="Consulta y cotización de yates; Gestión de tarifas y temporadas"/>
      <property key="Etapa E2E" value="Buscar yates y cotizar"/>
      <property key="Rol que lo usa" value="Arrendatario"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="S06 Reservar yate" id="id-5607f1a90a7d44cdba6fe28d25ee897e">
      <documentation>Confirma la reserva con pago inicial y contrato.</documentation>
      <property key="Capa" value="4 - Servicio básico"/>
      <property key="Servicio de gestión" value="G2"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Es el servicio central de la etapa «Reservar, contratar y asegurar» y el que dispara notificaciones, póliza y alistamiento."/>
      <property key="Fuente" value="Entrevista §2, §4"/>
      <property key="Capacidad" value="Gestión de reservas"/>
      <property key="Etapa E2E" value="Reservar, contratar y asegurar"/>
      <property key="Rol que lo usa" value="Arrendatario"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="S07 Cancelar o reprogramar reserva" id="id-34dd5ca1b32d453ea46ccb01a40d9b51">
      <documentation>Aplica la política de cancelación y reprogramación.</documentation>
      <property key="Capa" value="4 - Servicio básico"/>
      <property key="Servicio de gestión" value="G2"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Cubre el retroceso «el cliente puede cancelar» del proceso no lineal (entrevista §2 y §5)."/>
      <property key="Fuente" value="Entrevista §4, §5"/>
      <property key="Capacidad" value="Gestión de reservas"/>
      <property key="Etapa E2E" value="Retroceso: cancelación o reprogramación (entre «Reservar» y «Entregar»)"/>
      <property key="Rol que lo usa" value="Arrendatario"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="S08 Notificar reserva al propietario y a la marina" id="id-85624c49c50d4a5aa098c61aa6d0978b">
      <documentation>Informa a propietario y marina cada reserva confirmada.</documentation>
      <property key="Capa" value="4 - Servicio básico"/>
      <property key="Servicio de gestión" value="G2"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Requisito de la Fase 1 («notificación de cada reserva»); sustituye el WhatsApp informal por un evento trazable."/>
      <property key="Fuente" value="Entrevista §2, §3"/>
      <property key="Capacidad" value="Coordinación operativa con marinas"/>
      <property key="Requisito" value="Notificación de cada reserva al propietario y a la marina"/>
      <property key="Etapa E2E" value="Reservar, contratar y asegurar"/>
      <property key="Rol que lo usa" value="Operador de marina"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="S09 Solicitar evaluación de riesgo" id="id-d12ce1fa682e445084a01e608fb5a75a">
      <documentation>Envía los datos del cliente al evaluador y recibe su recomendación.</documentation>
      <property key="Capa" value="4 - Servicio básico"/>
      <property key="Servicio de gestión" value="G3"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="La evaluación la hace un tercero, pero la solicitud y el registro son nuestros: exige trazabilidad del insumo de la decisión."/>
      <property key="Fuente" value="Entrevista §2, §3"/>
      <property key="Capacidad" value="Evaluación de riesgo del cliente"/>
      <property key="Requisito" value="Evaluación de riesgo del cliente antes de aprobar el arriendo"/>
      <property key="Etapa E2E" value="Evaluar el riesgo del cliente"/>
      <property key="Rol que lo usa" value="Analista de riesgos"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="S10 Decidir aprobación del cliente" id="id-fd71a9960b3f4071afcc60856dfc73b9">
      <documentation>Registra la decisión del área de riesgos.</documentation>
      <property key="Capa" value="4 - Servicio básico"/>
      <property key="Servicio de gestión" value="G3"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Decisión crítica e indelegable (entrevista §9); se separa del servicio externo para que la regla sea propia."/>
      <property key="Fuente" value="Entrevista §3, §4, §9"/>
      <property key="Capacidad" value="Evaluación de riesgo del cliente"/>
      <property key="Requisito" value="Evaluación de riesgo del cliente antes de aprobar el arriendo"/>
      <property key="Etapa E2E" value="Evaluar el riesgo del cliente"/>
      <property key="Rol que lo usa" value="Analista de riesgos"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="S11 Definir condiciones del arriendo" id="id-3a1db7cf11c04c8eb0e50cf1796e5950">
      <documentation>Fija depósito mayor y capitán obligatorio según el riesgo.</documentation>
      <property key="Capa" value="4 - Servicio básico"/>
      <property key="Servicio de gestión" value="G3"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Traduce el riesgo en condiciones concretas que luego usan cotización, reserva y pagos."/>
      <property key="Fuente" value="Entrevista §2, §3, §4"/>
      <property key="Capacidad" value="Evaluación de riesgo del cliente"/>
      <property key="Etapa E2E" value="Evaluar el riesgo del cliente"/>
      <property key="Rol que lo usa" value="Analista de riesgos"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="S12 Emitir póliza del arriendo" id="id-477c0fec6afe438f866ac887398ea150">
      <documentation>Gestiona la póliza por arriendo con la aseguradora.</documentation>
      <property key="Capa" value="4 - Servicio básico"/>
      <property key="Servicio de gestión" value="G4"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="La aseguradora puede bloquear el proceso (entrevista §3) y la integración es la segunda más crítica."/>
      <property key="Fuente" value="Entrevista §3, §4"/>
      <property key="Capacidad" value="Gestión de seguros"/>
      <property key="Requisito" value="Pagos del arriendo: alquiler, depósito, seguro y combustible"/>
      <property key="Etapa E2E" value="Reservar, contratar y asegurar"/>
      <property key="Rol que lo usa" value="Gestor de seguros"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="S13 Reportar siniestro a la aseguradora" id="id-2548c26aacd445c08603e39462e52e2d">
      <documentation>Abre el caso de siniestro con la evidencia del acta.</documentation>
      <property key="Capa" value="4 - Servicio básico"/>
      <property key="Servicio de gestión" value="G4"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Hoy se hace por portal y correo manual; estandarizarlo reduce el costo de siniestralidad."/>
      <property key="Fuente" value="Entrevista §5"/>
      <property key="Capacidad" value="Gestión de seguros; Gestión de incidentes y siniestros"/>
      <property key="Etapa E2E" value="Cerrar el arriendo y ajustar los pagos (se reporta tras la inspección; vive en seguros porque es la relación con la aseguradora)"/>
      <property key="Rol que lo usa" value="Gestor de seguros"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="S14 Ordenar alistamiento del yate" id="id-060570731b5a4310be40892069205063">
      <documentation>Envía la orden de alistamiento y recibe la lista de verificación.</documentation>
      <property key="Capa" value="4 - Servicio básico"/>
      <property key="Servicio de gestión" value="G5"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Reemplaza el WhatsApp con órdenes claras (necesidad de las marinas, §9) y es la mayor fuente de errores de alistamiento."/>
      <property key="Fuente" value="Entrevista §1, §2"/>
      <property key="Capacidad" value="Alistamiento y entrega del yate"/>
      <property key="Etapa E2E" value="Preparar el yate"/>
      <property key="Rol que lo usa" value="Operador de marina"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="S15 Asignar capitán" id="id-dfb94f53ceee459486bec1b41d578124">
      <documentation>Pone un capitán de la red cuando es obligatorio u opcional.</documentation>
      <property key="Capa" value="4 - Servicio básico"/>
      <property key="Servicio de gestión" value="G5"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="La empresa pone el capitán desde una red independiente (entrevista §3)."/>
      <property key="Fuente" value="Entrevista §3"/>
      <property key="Capacidad" value="Gestión de capitanes"/>
      <property key="Etapa E2E" value="Preparar el yate"/>
      <property key="Rol que lo usa" value="Capitán"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="S16 Registrar entrega del yate" id="id-5ada83c6254949ab9c835251af2c2beb">
      <documentation>Firma el acta de entrega con fotos y combustible.</documentation>
      <property key="Capa" value="4 - Servicio básico"/>
      <property key="Servicio de gestión" value="G5"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Es la evidencia base para daños y combustible; hoy hay diferencias entre sensor y verificación manual."/>
      <property key="Fuente" value="Entrevista §2"/>
      <property key="Capacidad" value="Alistamiento y entrega del yate"/>
      <property key="Etapa E2E" value="Entregar el yate"/>
      <property key="Rol que lo usa" value="Operador de marina"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="S17 Registrar recepción e inspección del yate" id="id-ca9fb325a9114d498b55c9198751c426">
      <documentation>Inspecciona con el cliente presente y emite el informe.</documentation>
      <property key="Capa" value="4 - Servicio básico"/>
      <property key="Servicio de gestión" value="G5"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Requisito de la Fase 1 (inspección estandarizada); hoy las inspecciones son poco homogéneas entre marinas."/>
      <property key="Fuente" value="Entrevista §2, §5"/>
      <property key="Capacidad" value="Recepción e inspección del yate"/>
      <property key="Requisito" value="Inspección de cierre estandarizada con acta en 24 horas"/>
      <property key="Etapa E2E" value="Recibir e inspeccionar el yate"/>
      <property key="Rol que lo usa" value="Operador de marina"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="S18 Suspender salida del yate" id="id-e07ea392bead434da2400a54787acb1a">
      <documentation>Detiene la entrega por condiciones del yate o del clima.</documentation>
      <property key="Capa" value="4 - Servicio básico"/>
      <property key="Servicio de gestión" value="G5"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Retroceso regulado «la marina puede suspender la salida» (entrevista §2 y §3)."/>
      <property key="Fuente" value="Entrevista §2, §3, §4"/>
      <property key="Capacidad" value="Alistamiento y entrega del yate"/>
      <property key="Etapa E2E" value="Preparar el yate y Entregar el yate (retroceso por clima o condiciones)"/>
      <property key="Rol que lo usa" value="Operador de marina"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="S19 Registrar posición y combustible" id="id-5cf92a220c6d4a11a65251bf5f230448">
      <documentation>Recibe y almacena posición y nivel de combustible.</documentation>
      <property key="Capa" value="4 - Servicio básico"/>
      <property key="Servicio de gestión" value="G6"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Es el requisito de seguimiento en tiempo real y la base de la conciliación de combustible."/>
      <property key="Fuente" value="Entrevista §3, §7, §8"/>
      <property key="Capacidad" value="Seguimiento de ubicación y combustible"/>
      <property key="Requisito" value="Seguimiento en tiempo real de ubicación y combustible"/>
      <property key="Etapa E2E" value="Monitorear la navegación"/>
      <property key="Rol que lo usa" value="Monitor de operaciones"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="S20 Gestionar alerta de salida de zona o no devolución" id="id-17aa647bce8a4ab7aad2cbfe04f5693d">
      <documentation>Dispara y escala la alarma cuando el yate se sale de la zona.</documentation>
      <property key="Capa" value="4 - Servicio básico"/>
      <property key="Servicio de gestión" value="G6"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Cubre el riesgo de no devolución, que es uno de los que más preocupan al negocio."/>
      <property key="Fuente" value="Entrevista §5"/>
      <property key="Capacidad" value="Control de zona permitida y alertas"/>
      <property key="Requisito" value="Seguimiento en tiempo real de ubicación y combustible"/>
      <property key="Etapa E2E" value="Monitorear la navegación"/>
      <property key="Rol que lo usa" value="Monitor de operaciones"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="S21 Cobrar alquiler" id="id-133d9018e70147fab80c320f9df82363">
      <documentation>Cobra el 40% al reservar y el 60% siete días antes.</documentation>
      <property key="Capa" value="4 - Servicio básico"/>
      <property key="Servicio de gestión" value="G7"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Es el pago más frecuente del proceso (~6.500 arriendos al año)."/>
      <property key="Fuente" value="Entrevista §2"/>
      <property key="Capacidad" value="Cobro y conciliación de pagos del arriendo"/>
      <property key="Requisito" value="Pagos del arriendo: alquiler, depósito, seguro y combustible"/>
      <property key="Etapa E2E" value="Reservar, contratar y asegurar (40%) y Preparar el yate (60%)"/>
      <property key="Rol que lo usa" value="Arrendatario"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="S22 Pre-autorizar y liberar depósito" id="id-7e7124417e674e9d9544352eb346e742">
      <documentation>Pre-autoriza el depósito 48 h antes y lo libera o retiene.</documentation>
      <property key="Capa" value="4 - Servicio básico"/>
      <property key="Servicio de gestión" value="G7"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Soporta la meta de cierre y la política de no custodiar dinero."/>
      <property key="Fuente" value="Entrevista §2, §4, §6, §9"/>
      <property key="Capacidad" value="Gestión de depósitos de garantía"/>
      <property key="Requisito" value="Pagos del arriendo: alquiler, depósito, seguro y combustible"/>
      <property key="Etapa E2E" value="Preparar el yate (pre-autorización) y Cerrar el arriendo y ajustar los pagos (liberación)"/>
      <property key="Rol que lo usa" value="Tesorería"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="S23 Liquidar combustible y recargos por retraso" id="id-6008c2f6a3fe4861919ed58a1cd1326d">
      <documentation>Calcula combustible consumido y recargos.</documentation>
      <property key="Capa" value="4 - Servicio básico"/>
      <property key="Servicio de gestión" value="G7"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Hoy no se concilia bien el combustible; es una brecha de medición de la Fase 1."/>
      <property key="Fuente" value="Entrevista §2, §5"/>
      <property key="Capacidad" value="Ajustes de cierre (combustible y depósito)"/>
      <property key="Requisito" value="Pagos del arriendo: alquiler, depósito, seguro y combustible"/>
      <property key="Etapa E2E" value="Cerrar el arriendo y ajustar los pagos"/>
      <property key="Rol que lo usa" value="Tesorería"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="S24 Reembolsar pagos" id="id-b747d493f4c04afdadc3a42c1289c802">
      <documentation>Ejecuta los reembolsos que resultan de cancelaciones o suspensiones.</documentation>
      <property key="Capa" value="4 - Servicio básico"/>
      <property key="Servicio de gestión" value="G7"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Separa el movimiento del dinero de la regla que lo origina (S07)."/>
      <property key="Fuente" value="Entrevista §5"/>
      <property key="Capacidad" value="Cobro y conciliación de pagos del arriendo"/>
      <property key="Etapa E2E" value="Retroceso: cancelación o suspensión (entre «Reservar» y «Entregar»)"/>
      <property key="Rol que lo usa" value="Tesorería"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="S25 Cerrar arriendo" id="id-bc937035547949fa9ae10059aec1beaf">
      <documentation>Consolida combustible, retrasos, daños y decide sobre el depósito.</documentation>
      <property key="Capa" value="4 - Servicio básico"/>
      <property key="Servicio de gestión" value="G8"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Es el servicio que mide directamente la meta «agilizar el cierre»."/>
      <property key="Fuente" value="Entrevista §2, §6, §9"/>
      <property key="Capacidad" value="Ajustes de cierre (combustible y depósito)"/>
      <property key="Etapa E2E" value="Cerrar el arriendo y ajustar los pagos"/>
      <property key="Rol que lo usa" value="Tesorería"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="S26 Liquidar al propietario, a la marina y al capitán" id="id-6233cc41c0814235947c23709cbf53d0">
      <documentation>Reparte el dinero del arriendo entre el propietario, la marina y el capitán.</documentation>
      <property key="Capa" value="4 - Servicio básico"/>
      <property key="Servicio de gestión" value="G8"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Cubre la etapa final del E2E y la expectativa de cobrar a tiempo de propietarios y marinas; incluye el pago al capitán independiente, que la entrevista no asigna a otro servicio."/>
      <property key="Fuente" value="Entrevista §1, §2, §3; la forma de pago al capitán es propuesta"/>
      <property key="Capacidad" value="Liquidación y pago a propietarios y marinas"/>
      <property key="Etapa E2E" value="Liquidar y pagar a propietarios y marinas"/>
      <property key="Rol que lo usa" value="Tesorería"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="S27 Registrar y validar valoración de daños" id="id-c1395a4e541f4224a427cf19fcb3f641">
      <documentation>Registra el daño y el dictamen del perito.</documentation>
      <property key="Capa" value="4 - Servicio básico"/>
      <property key="Servicio de gestión" value="G9"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="El peritaje es externo, pero la decisión de cobro necesita un valor validado."/>
      <property key="Fuente" value="Entrevista §5"/>
      <property key="Capacidad" value="Gestión de incidentes y siniestros"/>
      <property key="Etapa E2E" value="Recibir e inspeccionar el yate (daños sobre COP 5M)"/>
      <property key="Rol que lo usa" value="Gestor de siniestros"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="S28 Aplicar cobro de daños" id="id-51babac48e9d43a59ae59aee1ddd739c">
      <documentation>Cobra el daño en el orden definido.</documentation>
      <property key="Capa" value="4 - Servicio básico"/>
      <property key="Servicio de gestión" value="G9"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Regla de negocio explícita y crítica; evita que cada marina o analista decida distinto."/>
      <property key="Fuente" value="Entrevista §5"/>
      <property key="Capacidad" value="Gestión de depósitos de garantía; Gestión de incidentes y siniestros"/>
      <property key="Etapa E2E" value="Cerrar el arriendo y ajustar los pagos"/>
      <property key="Rol que lo usa" value="Gestor de siniestros"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="S29 Gestionar objeción del propietario" id="id-674d8e7f098a4b4782caa0ffc6b60498">
      <documentation>Recibe y resuelve la objeción al informe.</documentation>
      <property key="Capa" value="4 - Servicio básico"/>
      <property key="Servicio de gestión" value="G9"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Responde a la necesidad de los propietarios de que su yate vuelva sin daños."/>
      <property key="Fuente" value="Entrevista §3, §5"/>
      <property key="Capacidad" value="Gestión de incidentes y siniestros"/>
      <property key="Etapa E2E" value="Recibir e inspeccionar el yate (48 h tras el informe)"/>
      <property key="Rol que lo usa" value="Propietario del yate"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="S30 Consolidar costo de siniestralidad por yate" id="id-084c68a405b0497f8c9a25d835e8547f">
      <documentation>Calcula el costo real de siniestros por yate.</documentation>
      <property key="Capa" value="4 - Servicio básico"/>
      <property key="Servicio de gestión" value="G9"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Es una brecha de medición reconocida («no medimos el costo real de siniestralidad por yate») y una meta del negocio."/>
      <property key="Fuente" value="Entrevista §6, §9"/>
      <property key="Capacidad" value="Gestión del desempeño e indicadores; Gestión de riesgos empresariales"/>
      <property key="Etapa E2E" value="Posterior al E2E: indicador periódico de desempeño"/>
      <property key="Rol que lo usa" value="Gestor de siniestros"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="S31 Gestionar accidente o emergencia" id="id-80be2c68473d4620992ad5463b1cd99e">
      <documentation>Coordina la respuesta a un accidente.</documentation>
      <property key="Capa" value="4 - Servicio básico"/>
      <property key="Servicio de gestión" value="G6"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Gestión de incidentes es una capacidad crítica e indelegable."/>
      <property key="Fuente" value="Entrevista §5"/>
      <property key="Capacidad" value="Gestión de incidentes y siniestros"/>
      <property key="Etapa E2E" value="Monitorear la navegación (emergencia durante el arriendo)"/>
      <property key="Rol que lo usa" value="Monitor de operaciones"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="S32 Registrar calificaciones mutuas" id="id-71189006271748bb885c0802ee09b058">
      <documentation>Cliente califica al propietario y viceversa.</documentation>
      <property key="Capa" value="4 - Servicio básico"/>
      <property key="Servicio de gestión" value="G10"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Requisito de la Fase 1 y fuente de la reputación."/>
      <property key="Fuente" value="Entrevista §3, §6"/>
      <property key="Capacidad" value="Calificaciones mutuas cliente–propietario"/>
      <property key="Requisito" value="Calificaciones mutuas entre cliente y propietario"/>
      <property key="Etapa E2E" value="Calificar mutuamente a cliente y propietario"/>
      <property key="Rol que lo usa" value="Arrendatario"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="S33 Aplicar consecuencias de la calificación" id="id-7a5866e8ecaa4687a83e219149dcc7cf">
      <documentation>Revisa o bloquea según los umbrales.</documentation>
      <property key="Capa" value="4 - Servicio básico"/>
      <property key="Servicio de gestión" value="G10"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Hace cumplir una regla de negocio explícita y conecta con S02 y S10."/>
      <property key="Fuente" value="Entrevista §6"/>
      <property key="Capacidad" value="Calificaciones mutuas cliente–propietario"/>
      <property key="Etapa E2E" value="Calificar mutuamente a cliente y propietario"/>
      <property key="Rol que lo usa" value="Analista de riesgos"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="F1 Maestro de clientes" id="id-c5c63a09c09b421e9d41efc6526a04a1">
      <documentation>Identidad, licencia o experiencia, consentimientos y calificación.</documentation>
      <property key="Capa" value="Servicio fundamental (datos maestros)"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Las reglas de riesgo y la Ley 1581 exigen un registro propio; el CRM guarda lo comercial y se integra por A02."/>
      <property key="Fuente" value="Entrevista §4, §6, §7"/>
      <property key="Capacidad" value="Gestión de relaciones con clientes (CRM)"/>
      <property key="Contrato" value="CT-F1"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="F2 Maestro de propietarios y contratos de exclusividad" id="id-fb658b17c393496c90dda5d94e9b09a7">
      <documentation>58 propietarios, contrato de 12 meses y condiciones de bloqueo.</documentation>
      <property key="Capa" value="Servicio fundamental (datos maestros)"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Sin este dato no se puede validar quién puede bloquear ni a quién liquidar."/>
      <property key="Fuente" value="Entrevista §1"/>
      <property key="Capacidad" value="Contratación y vinculación de propietarios"/>
      <property key="Contrato" value="CT-F2"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="F3 Maestro de yates" id="id-959fa60bf4db4311a00439f3ad8bbe35">
      <documentation>Matrícula, certificados, categoría, zona de 20 millas y dispositivo.</documentation>
      <property key="Capa" value="Servicio fundamental (datos maestros)"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Lo usan casi todos los servicios (cotización, depósito mínimo por categoría, capitán > 50 pies)."/>
      <property key="Fuente" value="Entrevista §1, §4, §7"/>
      <property key="Capacidad" value="Gestión de documentación y certificados del yate"/>
      <property key="Contrato" value="CT-F3"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="F4 Maestro de marinas y acuerdos de servicio" id="id-10563d9b196747088c7c2c27caf5e633">
      <documentation>6 marinas hoy, 10 como meta, con tarifas por servicio.</documentation>
      <property key="Capa" value="Servicio fundamental (datos maestros)"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="La expansión a 10 marinas exige parametrizar acuerdos y tarifas sin reprogramar."/>
      <property key="Fuente" value="Entrevista §1, §9"/>
      <property key="Capacidad" value="Coordinación operativa con marinas"/>
      <property key="Contrato" value="CT-F4"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="F5 Maestro de capitanes independientes" id="id-090f1603bf6c43998a974c4ca4626b07">
      <documentation>Red de capitanes, licencias y tarifa diaria que la empresa les paga.</documentation>
      <property key="Capa" value="Servicio fundamental (datos maestros)"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Necesario para asignar capitán (S15) y pagarle (S26)."/>
      <property key="Fuente" value="Entrevista §3"/>
      <property key="Capacidad" value="Gestión de capitanes"/>
      <property key="Contrato" value="CT-F5"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="F6 Tarifas, temporadas y políticas" id="id-6aaa6ea4599a4ec48bf5406b1e638cbb">
      <documentation>Tarifas, recargos, depósitos mínimos, cancelación y penalizaciones.</documentation>
      <property key="Capa" value="Servicio fundamental (datos maestros)"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Las reglas cambian por temporada y deben modificarse sin tocar los servicios."/>
      <property key="Fuente" value="Entrevista §4, §5"/>
      <property key="Capacidad" value="Gestión de tarifas y temporadas"/>
      <property key="Contrato" value="CT-F6"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="F7 Maestro de pólizas y coberturas" id="id-c0dff66eefab41a3897153da5da16cc0">
      <documentation>Coberturas, deducibles y mínimos que defina legal.</documentation>
      <property key="Capa" value="Servicio fundamental (datos maestros)"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="El equipo legal aún precisa la cobertura mínima (entrevista §7); debe ser parametrizable."/>
      <property key="Fuente" value="Entrevista §3, §4, §7"/>
      <property key="Capacidad" value="Gestión de seguros"/>
      <property key="Contrato" value="CT-F7"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="I1 Identidad y permisos" id="id-14f9919f804d44408f5ed249c965b02f">
      <documentation>Usuarios internos, marinas, propietarios, clientes y capitanes.</documentation>
      <property key="Capa" value="Servicio de infraestructura"/>
      <property key="Decisión" value="No implementar (adoptar solución estándar)"/>
      <property key="Justificación" value="No diferencia al negocio y el presupuesto es limitado; se adopta un servicio de identidad existente. Sin contrato propio: su interfaz la define el proveedor."/>
      <property key="Fuente" value="Entrevista §9; Fase 1"/>
      <property key="Contrato" value="No aplica: se adopta una solución estándar; la interfaz la define el proveedor."/>
    </element>
    <element xsi:type="archimate:BusinessService" name="I2 Notificaciones" id="id-9063523eb9084d018dc67a2f1beac4ab">
      <documentation>Mensajes por correo, WhatsApp o SMS con trazabilidad.</documentation>
      <property key="Capa" value="Servicio de infraestructura"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Reemplaza la comunicación informal con marinas, que es la principal fuente de errores."/>
      <property key="Fuente" value="Entrevista §8, §9"/>
      <property key="Capacidad" value="Coordinación operativa con marinas"/>
      <property key="Contrato" value="CT-I2"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="I3 Auditoría y trazabilidad de punta a punta" id="id-e69a1bc927d54fc08ccf7a803d8d2f1c">
      <documentation>Línea de tiempo por arriendo.</documentation>
      <property key="Capa" value="Servicio de infraestructura"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="La trazabilidad débil y los reclamos son un impulsor y un requisito de la Fase 1."/>
      <property key="Fuente" value="Entrevista §9; Fase 1 (requisito de trazabilidad)"/>
      <property key="Capacidad" value="Gestión del cumplimiento normativo y legal"/>
      <property key="Requisito" value="Trazabilidad de punta a punta de cada arriendo"/>
      <property key="Contrato" value="CT-I3"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="I4 Gestión documental" id="id-0b6b6d0994d149ee941053b607812921">
      <documentation>Contratos, actas, informes, fotos y pólizas.</documentation>
      <property key="Capa" value="Servicio de infraestructura"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Hoy el archivo de contratos está disperso; las actas con fotos son evidencia de daños."/>
      <property key="Fuente" value="Entrevista §2, §8"/>
      <property key="Capacidad" value="Gestión de contratos con propietarios y clientes"/>
      <property key="Contrato" value="CT-I4"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="I5 Consentimiento y protección de datos personales" id="id-4f4742c2e6ea4c2298d5c2aff04de25d">
      <documentation>Autorizaciones y política de privacidad.</documentation>
      <property key="Capa" value="Servicio de infraestructura"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Ley 1581 de 2012; la ubicación del cliente debe estar informada y autorizada."/>
      <property key="Fuente" value="Entrevista §7"/>
      <property key="Capacidad" value="Gestión de la protección de datos personales"/>
      <property key="Requisito" value="Protección de datos personales (Ley 1581 de 2012)"/>
      <property key="Contrato" value="CT-I5"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="A01 Integración con canales de distribución" id="id-53b8bf1ae63149d699e286d8ea95524e">
      <documentation>Aísla a los servicios de gestión de: Agencias de viaje, hoteles y canales digitales.</documentation>
      <property key="Capa" value="Capa anticorrupción (interoperabilidad)"/>
      <property key="Externo" value="Agencias de viaje, hoteles y canales digitales"/>
      <property key="Tipo de externo" value="Canal comercial (tercero)"/>
      <property key="Dirección" value="Ambas"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="El 75% de los clientes llega por web, redes, agencias y hoteles; sin una interfaz única cada canal duplicaría las reglas de disponibilidad y tarifa."/>
      <property key="Fuente" value="Ampliación (entrevista §1; no está en la tabla de §8)"/>
      <property key="Capacidad" value="Consulta y cotización de yates"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="A02 Integración con el CRM" id="id-fc1957b60d604d1a955695001fe783cc">
      <documentation>Aísla a los servicios de gestión de: CRM comercial.</documentation>
      <property key="Capa" value="Capa anticorrupción (interoperabilidad)"/>
      <property key="Externo" value="CRM comercial"/>
      <property key="Tipo de externo" value="Sistema existente (interno)"/>
      <property key="Dirección" value="Ambas"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="El CRM es la fuente comercial; la ACL evita que su modelo contamine los servicios de gestión y quita trabajo manual."/>
      <property key="Fuente" value="Entrevista §8. Propuesto (no está en §8): «reservas confirmadas, estado y calificación del cliente», lo que enviamos al CRM."/>
      <property key="Capacidad" value="Gestión de relaciones con clientes (CRM)"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="A03 Integración de contratos y firma electrónica" id="id-fbecf7755f5c45fba934ddfdb76e52cc">
      <documentation>Aísla a los servicios de gestión de: Proveedor de firma electrónica y archivo de contratos.</documentation>
      <property key="Capa" value="Capa anticorrupción (interoperabilidad)"/>
      <property key="Externo" value="Proveedor de firma electrónica y archivo de contratos"/>
      <property key="Tipo de externo" value="Sistema existente (tercero)"/>
      <property key="Dirección" value="Ambas"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="La firma electrónica ya existe; falta un punto único que devuelva el contrato firmado y lo asocie a la reserva."/>
      <property key="Fuente" value="Entrevista §8"/>
      <property key="Capacidad" value="Gestión de contratos con propietarios y clientes"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="A04 Integración con la aseguradora" id="id-e5dc181e5edc44929881dece5ddeee43">
      <documentation>Aísla a los servicios de gestión de: Aseguradora.</documentation>
      <property key="Capa" value="Capa anticorrupción (interoperabilidad)"/>
      <property key="Externo" value="Aseguradora"/>
      <property key="Tipo de externo" value="Proveedor externo"/>
      <property key="Dirección" value="Ambas"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Es la segunda integración más crítica según el negocio; la aseguradora puede bloquear el proceso."/>
      <property key="Fuente" value="Entrevista §8. Propuesto (§8 solo menciona la póliza): «número de caso y decisión de cobertura», lo que recibimos de la aseguradora."/>
      <property key="Capacidad" value="Gestión de seguros"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="A05 Integración con el evaluador de riesgo" id="id-351aee4a1f5149c28772042d2291e77b">
      <documentation>Aísla a los servicios de gestión de: Evaluador de riesgo (externo).</documentation>
      <property key="Capa" value="Capa anticorrupción (interoperabilidad)"/>
      <property key="Externo" value="Evaluador de riesgo (externo)"/>
      <property key="Tipo de externo" value="Proveedor externo"/>
      <property key="Dirección" value="Ambas"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Aísla el formato del evaluador y deja registro del insumo de la decisión de riesgo."/>
      <property key="Fuente" value="Entrevista §8"/>
      <property key="Capacidad" value="Evaluación de riesgo del cliente"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="A06 Integración con marinas" id="id-2d3a61d22c89470799209ee7179762e7">
      <documentation>Aísla a los servicios de gestión de: Marinas aliadas.</documentation>
      <property key="Capa" value="Capa anticorrupción (interoperabilidad)"/>
      <property key="Externo" value="Marinas aliadas"/>
      <property key="Tipo de externo" value="Proveedor externo (6 hoy, 10 meta)"/>
      <property key="Dirección" value="Ambas"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Es la más crítica de automatizar: de la comunicación informal sale la mayoría de errores de alistamiento."/>
      <property key="Fuente" value="Entrevista §8"/>
      <property key="Capacidad" value="Coordinación operativa con marinas"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="A07 Integración con la pasarela de pagos" id="id-a515eb6180bd4e92bb2635f880defcba">
      <documentation>Aísla a los servicios de gestión de: Pasarela de pagos.</documentation>
      <property key="Capa" value="Capa anticorrupción (interoperabilidad)"/>
      <property key="Externo" value="Pasarela de pagos"/>
      <property key="Tipo de externo" value="Proveedor externo"/>
      <property key="Dirección" value="Ambas"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Cambiar de pasarela no debe afectar las reglas de pago; el depósito se maneja por pre-autorización."/>
      <property key="Fuente" value="Entrevista §8"/>
      <property key="Capacidad" value="Cobro y conciliación de pagos del arriendo"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="A08 Integración con el proveedor de seguimiento" id="id-080ad5d9cf9c41259121ab3be49670f7">
      <documentation>Aísla a los servicios de gestión de: Proveedor de seguimiento (GPS y sensor de nivel).</documentation>
      <property key="Capa" value="Capa anticorrupción (interoperabilidad)"/>
      <property key="Externo" value="Proveedor de seguimiento (GPS y sensor de nivel)"/>
      <property key="Tipo de externo" value="Dispositivo y proveedor externo"/>
      <property key="Dirección" value="Hacia nosotros"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Aísla el protocolo del dispositivo; debe almacenar y reenviar porque se pierde conectividad pasadas ~12 millas."/>
      <property key="Fuente" value="Entrevista §8"/>
      <property key="Capacidad" value="Seguimiento de ubicación y combustible"/>
      <property key="Requisito" value="Seguimiento en tiempo real de ubicación y combustible"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="A09 Integración con autoridades marítimas" id="id-5c773f14ea0d4b269f4b4ad0b03a5a9b">
      <documentation>Aísla a los servicios de gestión de: Autoridades marítimas (DIMAR y capitanías de puerto).</documentation>
      <property key="Capa" value="Capa anticorrupción (interoperabilidad)"/>
      <property key="Externo" value="Autoridades marítimas (DIMAR y capitanías de puerto)"/>
      <property key="Tipo de externo" value="Entidad regulatoria"/>
      <property key="Dirección" value="Hacia ellos; entrada por confirmar"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Los reportes son obligatorios; el sentido de entrada (alertas de capitanía) es una ampliación porque sin ella no se puede cumplir la regla de no zarpar con alerta."/>
      <property key="Fuente" value="Entrevista §3, §4, §5 y §8 (la capitanía autoriza el zarpe y cierra puertos; §3 y §4); ampliación de la entrada"/>
      <property key="Capacidad" value="Gestión del cumplimiento normativo y legal"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="A10 Integración con contabilidad y facturación" id="id-42046c17f8854568a701f0b041aa04b7">
      <documentation>Aísla a los servicios de gestión de: Contabilidad y facturación electrónica.</documentation>
      <property key="Capa" value="Capa anticorrupción (interoperabilidad)"/>
      <property key="Externo" value="Contabilidad y facturación electrónica"/>
      <property key="Tipo de externo" value="Proceso interno"/>
      <property key="Dirección" value="Hacia ellos"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="La facturación ante la DIAN se mantiene fuera de la aplicación; solo se entrega la información de cierre."/>
      <property key="Fuente" value="Entrevista §8"/>
      <property key="Capacidad" value="Liquidación y pago a propietarios y marinas"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="A11 Integración con la red de capitanes" id="id-b33e47e27dc545348cbb3004044c7f94">
      <documentation>Aísla a los servicios de gestión de: Red de capitanes independientes.</documentation>
