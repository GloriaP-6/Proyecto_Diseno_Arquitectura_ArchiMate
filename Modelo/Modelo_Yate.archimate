    <element xsi:type="archimate:Assessment" name="Debilidad: trazabilidad débil e inspecciones poco homogéneas" id="id-bae53e3bc1fa41a5b39485ce903fd7e0"/>
    <element xsi:type="archimate:Assessment" name="Debilidad: comunicación manual con las marinas (WhatsApp y correo)" id="id-d4cea064e5b44e46bc3d6cf42d4dd48d"/>
    <element xsi:type="archimate:Goal" name="Aumentar la ocupación de la flota" id="id-93143b9c78d84f79bf23746e1837afa0"/>
    <element xsi:type="archimate:Goal" name="Expandir la flota y la red de marinas" id="id-4a81700396c64b699a4fe6838a1bd2fc"/>
    <element xsi:type="archimate:Goal" name="Reducir la siniestralidad" id="id-83b6ebd6421848d581f80294f196aa15"/>
    <element xsi:type="archimate:Goal" name="Agilizar el cierre del arriendo y la devolución del depósito" id="id-54f8993f3d774907bceabd4ad26cf3c5"/>
    <element xsi:type="archimate:Outcome" name="Flota de unos 150 yates (hoy 85)" id="id-1acd0a411a0f4ed7a65e44deeb209890"/>
    <element xsi:type="archimate:Outcome" name="Red de 10 marinas (hoy 6)" id="id-a37a9dbc3d6b4770b1ec552e5f755936"/>
    <element xsi:type="archimate:Outcome" name="Ocupación promedio del 55% (hoy 45%)" id="id-9337dd592cdb4e87aaddda50e2d6da72"/>
    <element xsi:type="archimate:Outcome" name="Cierre y devolución del depósito en 3 días hábiles (hoy 5)" id="id-7049fb89e5924801b5b81baa58632b5a"/>
    <element xsi:type="archimate:Outcome" name="Daños sobre el deducible en 0,5% de los arriendos (hoy 1%)" id="id-64ec2cbf687747b5b771785dbff8f8dd"/>
    <element xsi:type="archimate:Principle" name="Transparencia" id="id-b955d48238a44a05a76b3ace0e3ddd8e"/>
    <element xsi:type="archimate:Principle" name="Seguridad" id="id-0b5881ee2d6b4a46bf0f8f1a3390b805"/>
    <element xsi:type="archimate:Principle" name="Cumplimiento" id="id-b6ce3ec3885b43018077381cda6c7efb"/>
    <element xsi:type="archimate:Constraint" name="Presupuesto limitado" id="id-87dc3b1a94d442e59fa08a09157b7d4b"/>
    <element xsi:type="archimate:Constraint" name="Disponibilidad de marinas" id="id-c5d823c5985f49d6a69e3fed9ac35ebc"/>
    <element xsi:type="archimate:Constraint" name="Conectividad en el mar (se pierde pasadas ~12 millas)" id="id-1163e738f7774f89a84633faafa6d193"/>
    <element xsi:type="archimate:Constraint" name="Regulación marítima, de datos y de consumo (DIMAR, Ley 1581, Ley 1480)" id="id-d83d56bf853b427098dcde03d34cfab7"/>
    <element xsi:type="archimate:Requirement" name="Habilitación y bloqueo del yate por su propietario" id="id-a6efa122b33a45a394d85f1b6b7bbb55"/>
    <element xsi:type="archimate:Requirement" name="Inventario de yates consultable por la marina más cercana" id="id-6233da29f871428f8f186ebf08a881c2"/>
    <element xsi:type="archimate:Requirement" name="Notificación de cada reserva al propietario y a la marina" id="id-888f4b16d38741d38b019ed0cba48a19"/>
    <element xsi:type="archimate:Requirement" name="Inspección de cierre estandarizada con acta en 24 horas" id="id-6e222df6bfea47fcab1a7a47334f040c"/>
    <element xsi:type="archimate:Requirement" name="Calificaciones mutuas entre cliente y propietario" id="id-6acd091e7d784cc7b7d5eea614957e63"/>
    <element xsi:type="archimate:Requirement" name="Pagos del arriendo: alquiler, depósito, seguro y combustible" id="id-40cfa96a886b446c88dd2f74ea718bbe"/>
    <element xsi:type="archimate:Requirement" name="Evaluación de riesgo del cliente antes de aprobar el arriendo" id="id-9fc94629dbb44b8a8a1fa540a899a157"/>
    <element xsi:type="archimate:Requirement" name="Trazabilidad de punta a punta de cada arriendo" id="id-56207fa2b79d49e6a1a18edfb6d6f838"/>
    <element xsi:type="archimate:Requirement" name="Seguimiento en tiempo real de ubicación y combustible" id="id-5e5342e116dc438db4e25f608b8f69d0"/>
    <element xsi:type="archimate:Requirement" name="Protección de datos personales (Ley 1581 de 2012)" id="id-dbd443f993774704913453b5477da169"/>
    <element xsi:type="archimate:Requirement" name="Medición del costo de siniestralidad por yate y de la conciliación de combustible" id="id-1321c82dae8948d097c64df64f2a0192">
      <documentation>La capacidad «Gobierno y Desempeño» (impacto parcial) no realizaba ningún requisito, así que S30 no llegaba a una meta.</documentation>
      <property key="Origen" value="Agregado en la corrección de la Fase 2; sale de la brecha de medición de V1"/>
      <property key="Estado" value="Supuesto: validar con el negocio"/>
    </element>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-eef5fb8ac23a4a949a67e72b6555306f" type="implementation_migration"/>
  <folder name="Other" id="id-df3db288bbf64d679c7ebdfcf07e1196" type="other">
    <folder name="Fase 3 - Other" id="id-c18bd8f9a7d54bba91d98ce1e727b82f">
      <element xsi:type="archimate:Grouping" name="CORE DOMAIN" id="1347fe2e-e390-48b8-a233-c5e37b7624b7">
        <documentation>Núcleo estratégico: agrega valor y diferencia al negocio.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="SUPPORTING DOMAINS" id="f0329686-42ce-4c0f-b012-55e4355e9ddb">
        <documentation>Áreas especializadas que apoyan el núcleo, sin ser el principal diferenciador.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="GENERIC DOMAINS" id="3746568d-6441-43fb-834e-1e3d45cfaecf">
        <documentation>Problemas estándar y no diferenciadores.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Gestión del Arrendamiento" id="5a1668e4-1256-40c8-b863-66d4c843516f">
        <documentation>Clasificación: CORE
Argumento: Orquesta el ciclo de vida del producto principal: solicitud, elegibilidad, reserva, contrato, póliza por arriendo, preparación, ejecución, devolución y cierre.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Decisión de Riesgo del Arrendamiento" id="9f8686f0-8d5c-4ede-9d09-c83424fb110b">
        <documentation>Clasificación: CORE
Argumento: La empresa no delega la decisión de aceptar, condicionar o rechazar el riesgo de entregar un activo de alto valor de un tercero.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Gestión de Propietarios y Yates" id="1e2d7626-e08e-482a-bfe8-a12b18679849">
        <documentation>Clasificación: CORE
Argumento: Controla la relación con el propietario y la aptitud del activo ofrecido: habilitación, bloqueos, documentación y póliza anual.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Gestión de Marinas y Operación Náutica" id="38f4fbae-099a-4154-a5da-bf5c30d463a1">
        <documentation>Clasificación: CORE
Argumento: Coordina la ejecución física del arriendo con marinas y capitanes: alistamiento, entrega, recepción e inspección.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Gestión de Incidentes y Siniestros" id="5e0a99c7-8f3c-43cf-8efb-27a5640830b3">
        <documentation>Clasificación: CORE
Argumento: Gestiona novedades críticas, daños, peritajes y reclamaciones al seguro para proteger un activo ajeno y mantener trazabilidad.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Tarifación y Cotización" id="76837a81-c965-4d6f-9f1f-dfdd05eef22f">
        <documentation>Clasificación: SUPPORTING
Argumento: Calcula precios y condiciones económicas previas a la reserva; apoya el núcleo sin constituir el principal diferenciador.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Admisibilidad y Cumplimiento" id="af1f9378-e3f8-4fb0-ae10-3656e9c3d024">
        <documentation>Clasificación: SUPPORTING
Argumento: Decide si una contraparte u operación es admisible desde políticas y obligaciones de cumplimiento, separada de la decisión de riesgo.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Seguimiento Operacional" id="8d566d3e-8218-42dc-9896-9a108561d040">
        <documentation>Clasificación: SUPPORTING
Argumento: Registra ubicación, combustible, zonas y alertas para apoyar control operacional e incidentes; en esta iteración no depende de una plataforma náutica externa.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Liquidación Económica" id="8a62fd66-7d11-49ee-8c9b-3ca8f04433f7">
        <documentation>Clasificación: SUPPORTING
Argumento: Aplica reglas de cierre: combustible, retrasos, daños, depósito y distribución económica entre las partes.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Reputación y Calidad" id="e96755e9-5ec5-4cbc-acf8-9cc805abb2bd">
        <documentation>Clasificación: SUPPORTING
Argumento: Mantiene confianza y calidad operacional mediante calificaciones, reputación, consecuencias y planes de mejora. El ciclo completo de reclamos queda fuera del alcance.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Pagos y Facturación" id="0e7c19a4-7af0-4851-9139-db45dca98efe">
        <documentation>Clasificación: GENERIC
Argumento: Ejecuta capacidades estándar de cobro, preautorización, reembolso e intercambio con el sistema contable/facturador; se apoya en integraciones reales A07 y A10.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Analítica y Reportes" id="026eab0a-77f5-4bfa-b2f5-57c71d777a53">
        <documentation>Clasificación: GENERIC
Argumento: Consolida indicadores y reportes a partir de datos ya producidos por los dominios transaccionales.</documentation>
      </element>
    </folder>
