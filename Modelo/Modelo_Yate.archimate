    <element xsi:type="archimate:Capability" name="Reputación y Calidad del Servicio" id="id-7816d5a30074462d9f80cb640aa0357a">
      <documentation>Calificaciones mutuas (promedio 4,6/5); NPS cercano a 60.</documentation>
      <property key="Nivel" value="1"/>
    </element>
    <element xsi:type="archimate:Capability" name="Calificaciones mutuas cliente–propietario" id="id-7b684403713a4ea4acb93e6ee5ab92ea">
      <property key="Nivel" value="2"/>
      <property key="Relación con la solución" value="Impacta (alta)"/>
    </element>
