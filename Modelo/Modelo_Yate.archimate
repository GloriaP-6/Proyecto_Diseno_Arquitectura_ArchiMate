      <element xsi:type="archimate:ServingRelationship" name="Cliente-Proveedor · LP" id="id-d750aba905ea4022a84e9faf924b10c8" source="id-4a4274651313427fa3385fb906c876ad" target="id-d72aa552c98f4a17bb4a0b58cce78a3e">
        <property key="Patrón" value="Cliente-Proveedor + Lenguaje publicado"/>
        <property key="Upstream" value="Reputación y Calidad"/>
        <property key="Downstream" value="Decisión de Riesgo del Arrendamiento"/>
        <property key="Eventos U→D" value="ReputacionActualizada"/>
        <property key="Eventos D→U" value="—"/>
        <property key="Justificación" value="Liquidación decide cuánto y publica un contrato estable de cierre económico; Pagos y Facturación consume esas instrucciones para ejecutar o registrar movimientos. No comparten un modelo mutable ni requieren un núcleo compartido."/>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="DanioDetectado" id="id-dcfab6ca516541dab28a800d8c6a862f" source="id-bdcdd208881b4bdab0a34304467b2d02" target="id-1ecb0b37e3a54199b90f5ccccd70e763">
        <property key="Eventos" value="DanioDetectado"/>
      </element>
      <element xsi:type="archimate:ServingRelationship" name="Cliente-Proveedor · LP" id="id-dd506bd5a4e746d59e2d1a339a0d2358" source="id-b5f6f9b31a314198b0b29c54729b8ce1" target="id-057ddd6e74c64b30a2f3c43432ce1ab4">
        <property key="Patrón" value="Cliente-Proveedor + Lenguaje publicado"/>
        <property key="Upstream" value="Gestión de Propietarios y Yates"/>
        <property key="Downstream" value="Gestión del Arrendamiento"/>
        <property key="Eventos U→D" value="DisponibilidadConfirmada, DisponibilidadNegada, YateBloqueado"/>
        <property key="Eventos D→U" value="SolicitudReservaCreada"/>
        <property key="Justificación" value="Liquidación decide cuánto y publica un contrato estable de cierre económico; Pagos y Facturación consume esas instrucciones para ejecutar o registrar movimientos. No comparten un modelo mutable ni requieren un núcleo compartido."/>
      </element>
      <element xsi:type="archimate:ServingRelationship" name="Conformista" id="id-e2761c5fdb2d4b668e8f6f6c09365993" source="id-ff3f0e8681cc4f3ea60c867c0cb68a60" target="id-5c13bf8793104972988fe40d38089a1a">
        <property key="Patrón" value="Conformista"/>
        <property key="Upstream" value="Liquidación Económica"/>
        <property key="Downstream" value="Analítica y Reportes"/>
        <property key="Eventos U→D" value="LiquidacionFinalizada"/>
        <property key="Eventos D→U" value="—"/>
        <property key="Justificación" value="Analítica consume lo publicado sin modificar nada (conformista)."/>
      </element>
      <element xsi:type="archimate:ServingRelationship" name="Cliente-Proveedor · LP" id="id-e766b6850f74454c929bafb349ec134f" source="id-ff3f0e8681cc4f3ea60c867c0cb68a60" target="id-0bf327aac9cc49f3a14eaedeef182a15">
        <documentation>Liquidación decide el cierre económico y publica instrucciones/resultados; Pagos y Facturación los ejecuta o registra mediante un contrato explícito de lenguaje publicado.</documentation>
        <property key="Patrón" value="Cliente-Proveedor + Lenguaje publicado"/>
        <property key="Upstream" value="Liquidación Económica"/>
        <property key="Downstream" value="Pagos y Facturación"/>
        <property key="Eventos U→D" value="AjusteLiquidacionRegistrado, CierreEconomicoPreparado, DepositoAplicado"/>
        <property key="Eventos D→U" value="—"/>
        <property key="Justificación" value="Liquidación decide cuánto y publica un contrato estable de cierre económico; Pagos y Facturación consume esas instrucciones para ejecutar o registrar movimientos. No comparten un modelo mutable ni requieren un núcleo compartido."/>
      </element>
      <element xsi:type="archimate:ServingRelationship" name="Conformista" id="id-e80ca834e79545c1addfae938dced0a3" source="id-222f7a91444c4f59b7f6fb017d475210" target="id-35cb2a6bc3c142e39745c98d973a5e5c">
        <property key="Patrón" value="Conformista"/>
        <property key="Upstream" value="Gestión del Arrendamiento"/>
        <property key="Downstream" value="Seguimiento Operacional"/>
        <property key="Eventos U→D" value="ArrendamientoIniciado, ArrendamientoDevuelto"/>
        <property key="Eventos D→U" value="—"/>
        <property key="Justificación" value="Seguimiento solo necesita saber cuándo empieza y termina el arriendo; adopta el lenguaje publicado de Arrendamiento (conformista) y no pide cambios."/>
      </element>
      <element xsi:type="archimate:AssociationRelationship" name="Caminos separados (A01)" id="id-eb23d087a2a94e3f94c7bf3cbeb7fa7a" source="id-4172991fe3994d56bfab643f2cc0066a" target="id-39bb9fb9a96b40e6bac202b82d304bf3"/>
