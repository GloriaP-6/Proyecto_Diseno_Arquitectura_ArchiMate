      <property key="Errores y excepciones" value="Sin conectividad."/>
      <property key="Calidad" value="Atención inmediata 24/7 (entrevista §5)."/>
      <property key="Etapa del E2E" value="Monitorear la navegación (emergencia durante el arriendo)"/>
