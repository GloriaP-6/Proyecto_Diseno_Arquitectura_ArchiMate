        <property key="Cómo se cubre en esta versión" value="Se implementa una integración real con una pasarela de pagos en ambiente de pruebas/sandbox o equivalente, incluyendo transacciones, preautorizaciones, reembolsos y registro de respuestas/webhooks."/>
        <property key="Patrón" value="ACL: la pasarela es upstream y tiene su propio modelo; la interfaz A07 protege a Pagos"/>
      </element>
