            <bounds x="28" y="276" width="844" height="58"/>
          </child>
          <child xsi:type="archimate:DiagramObject" id="c50d273e-eef5-46a8-98ac-ac839cd90c95" archimateElement="50752c79-644e-4cd6-85b9-aebe1f089908">
            <bounds x="28" y="352" width="844" height="58"/>
          </child>
          <child xsi:type="archimate:DiagramObject" id="ca9f5b54-e4cd-41bf-8641-fcbc965ff7c5" archimateElement="558cbf76-4498-49cc-9808-09f092da167e">
            <bounds x="28" y="428" width="844" height="58"/>
          </child>
          <child xsi:type="archimate:DiagramObject" id="56cd619d-1cce-4e7a-9e24-cc7d22e193dd" archimateElement="8d8a12e2-8f33-4c02-a9d1-dc6880955f00">
            <bounds x="28" y="504" width="844" height="58"/>
          </child>
          <child xsi:type="archimate:DiagramObject" id="4caca400-e4d9-41cf-9908-be6fd9d96685" archimateElement="d0ef5085-8536-473d-83e7-d07fcf676b3f">
            <bounds x="28" y="580" width="844" height="58"/>
