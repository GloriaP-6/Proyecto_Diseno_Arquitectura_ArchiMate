      <property key="Nivel" value="2"/>
      <property key="Relación con la solución" value="Impacta (alta)"/>
    </element>
    <element xsi:type="archimate:Capability" name="Gestión del Riesgo del Arrendamiento" id="id-c72bfa5a3a674e1ca87bc97c055d5170">
      <documentation>Evaluación del cliente, póliza por arriendo, depósito, inspección y manejo de siniestros. Es la propuesta de valor principal.</documentation>
      <property key="Nivel" value="1"/>
    </element>
    <element xsi:type="archimate:Capability" name="Gestión de contratos con propietarios y clientes" id="id-8976666014b2432496ff03f1759bb44e">
      <property key="Nivel" value="2"/>
      <property key="Relación con la solución" value="Impacta (parcial)"/>
    </element>
