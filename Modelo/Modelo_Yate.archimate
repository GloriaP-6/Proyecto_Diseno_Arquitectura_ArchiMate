      <property key="Dominio(s) de Fase 3" value="Gestión de Incidentes y Siniestros"/>
      <property key="Agregados (Fase 4)" value="Incidente; ReclamacionSeguro"/>
      <property key="Responsable lógico" value="Área de operación / emergencias"/>
      <property key="Lenguaje ubicuo clave" value="Incidente, Siniestro, Peritaje, Reclamación al seguro"/>
