    </element>
    <element xsi:type="archimate:ApplicationComponent" name="BC Analítica y Reportes" id="id-8d8ebd42e5374c539e2eaf5faa64a753">
      <documentation>Consolida indicadores y reportes a partir de eventos ya publicados; nunca modifica agregados de otros contextos.</documentation>
