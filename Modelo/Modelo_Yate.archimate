        </child>
        <child xsi:type="archimate:DiagramObject" id="id-dd2c6e47aa3747b48c9b86bfea47120f" targetConnections="id-30c3b9bab53f46e6ab4683e64c0167b4 id-3f32288ae8544d12a8d1aa9a751867fb id-49f8392a1646444ebd5f6e2f1d3fc830" fillColor="#6FA8DC" archimateElement="id-bdcdd208881b4bdab0a34304467b2d02">
