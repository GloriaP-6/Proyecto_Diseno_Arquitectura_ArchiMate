      <property key="Nivel" value="2"/>
      <property key="Relación con la solución" value="Sin impacto directo"/>
    </element>
    <element xsi:type="archimate:Capability" name="Gestión de Pagos y Liquidación" id="id-335bde86e1b94387bffc1023349e32d1">
      <documentation>Alquiler (40% al reservar, 60% siete días antes), depósito por pre-autorización, seguro y combustible; liquidación 75% propietario / 25% empresa.</documentation>
      <property key="Nivel" value="1"/>
    </element>
    <element xsi:type="archimate:Capability" name="Liquidación y pago a propietarios y marinas" id="id-8b946c1c3ed84c3484949dc99970f779">
