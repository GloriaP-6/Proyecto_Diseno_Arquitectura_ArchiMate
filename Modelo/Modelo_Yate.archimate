    <element xsi:type="archimate:Resource" name="Alianzas con aseguradoras" id="id-806d13ba600d4d2ba1ca76ae9314d1a8"/>
    <element xsi:type="archimate:Resource" name="Dispositivos de seguimiento (GPS y sensor de combustible)" id="id-112643a4cc804b369c50bfe15e08fb25"/>
    <element xsi:type="archimate:Resource" name="Red de capitanes independientes" id="id-8f656101331a4ffc9311894ace124e4a"/>
    <element xsi:type="archimate:Resource" name="Pasarela de pagos" id="id-1704038f448349a890222595938ff901"/>
    <element xsi:type="archimate:CourseOfAction" name="Implementar la plataforma de gestión del arrendamiento de yates" id="id-b6a8cfa057b843bc87b78c9d78beba48">
      <documentation>Software que apoya toda la gestión del arrendamiento, de la reserva a la devolución, con control del riesgo de entregar bienes de terceros.</documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="Arrendamiento de yates de terceros" id="id-9191fffd7d704ada89be400e65bee6bf">
      <documentation>Cadena de valor de la empresa: de la captación del cliente hasta que el depósito se devuelve o retiene y el propietario recibe su pago.</documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="Captación y cotización" id="id-e4ca5062a43543478b4db03d4e855edd"/>
