          <documentation>Comportamiento de aplicación que maneja un comando o reacciona a un evento y protege las invariantes del agregado.</documentation>
        </element>
        <element xsi:type="archimate:ApplicationProcess" name="Recalcular reputación" id="e1dd9924-8731-40aa-9119-bf486022b854">
          <documentation>Comportamiento de aplicación que maneja un comando o reacciona a un evento y protege las invariantes del agregado.</documentation>
        </element>
        <element xsi:type="archimate:ApplicationProcess" name="Aplicar consecuencia / plan de mejora" id="45338b3e-b255-4d2c-9f76-1dadd3cc3c7e">
