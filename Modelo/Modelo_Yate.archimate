      <property key="Salida" value="Ficha de la marina con sus acuerdos."/>
      <property key="Reglas de negocio" value="Acuerdos de preferencia, no de exclusividad; tarifa de COP 350.000 a 700.000 por arriendo según tamaño, incluida en el precio al cliente; meta de 10 marinas."/>
