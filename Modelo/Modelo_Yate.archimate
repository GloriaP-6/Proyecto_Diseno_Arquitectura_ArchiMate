      <folder name="Gestión de Incidentes y Siniestros" id="cedd1ea2-48d0-4d7a-82ba-0438ef4b1b07">
        <element xsi:type="archimate:DataObject" name="Incidente «Aggregate Root»" id="d1e9a62e-dd78-4906-b60a-22a36c02f835">
          <documentation>Rol DDD: Aggregate Root. ABIERTO → EN_GESTION → ESCALADO (si aplica) → RESUELTO → CERRADO. Puede reabrirse por nueva evidencia.
Referencias externas: ArrendamientoId · YateId · ClienteId
Invariantes:
1. Todo incidente se asocia a arriendo/yate identificables.
2. Posible no devolución con >2 horas sin respuesta se escala según protocolo.
3. Daño > COP 5M no cierra evaluación sin peritaje.
4. Notificaciones a autoridad/aseguradora quedan auditadas y no se eliminan.</documentation>
        </element>
        <element xsi:type="archimate:DataObject" name="Peritaje «Entity»" id="c3e0ba6e-2a13-4cec-bf50-87d7999d08fc">
          <documentation>Entidad interna del agregado Incidente. Tiene identidad y ciclo de vida propio dentro del límite.</documentation>
        </element>
        <element xsi:type="archimate:DataObject" name="TipoIncidente «Value Object»" id="cede3831-7154-41be-abb6-4c2746b2178b">
          <documentation>Objeto de valor del agregado Incidente; se define por sus valores, no por identidad independiente.</documentation>
        </element>
        <element xsi:type="archimate:DataObject" name="EstadoIncidente «Value Object»" id="0eeace15-9c47-41a9-8e58-c359d7a2bfaf">
          <documentation>Objeto de valor del agregado Incidente; se define por sus valores, no por identidad independiente.</documentation>
        </element>
        <element xsi:type="archimate:DataObject" name="Severidad «Value Object»" id="f6ab8f2e-a42e-46e7-9895-c4b1e6fe9c36">
          <documentation>Objeto de valor del agregado Incidente; se define por sus valores, no por identidad independiente.</documentation>
        </element>
        <element xsi:type="archimate:DataObject" name="UbicacionIncidente «Value Object»" id="5bf61f40-27ef-4882-8944-d07fb8566c2c">
          <documentation>Objeto de valor del agregado Incidente; se define por sus valores, no por identidad independiente.</documentation>
        </element>
        <element xsi:type="archimate:DataObject" name="DanioEstimado «Value Object»" id="4393ac80-25cf-4581-94b1-bcdd9c2dc18b">
          <documentation>Objeto de valor del agregado Incidente; se define por sus valores, no por identidad independiente.</documentation>
        </element>
        <element xsi:type="archimate:DataObject" name="ResultadoPeritaje «Value Object»" id="01285070-53af-4f29-a951-8d00b97b25fc">
          <documentation>Objeto de valor del agregado Incidente; se define por sus valores, no por identidad independiente.</documentation>
        </element>
        <element xsi:type="archimate:DataObject" name="EvidenciaIncidente «Value Object»" id="c7cac604-df2f-413a-aca2-7409a12ee6f7">
          <documentation>Objeto de valor del agregado Incidente; se define por sus valores, no por identidad independiente.</documentation>
        </element>
        <element xsi:type="archimate:DataObject" name="ReclamacionSeguro «Aggregate Root»" id="e7a4b8fb-c28a-4dc8-9aad-b4ffa28b1e1f">
          <documentation>Rol DDD: Aggregate Root. PREPARADA → PRESENTADA_REGISTRADA → EN_ESTUDIO → RESUELTA. Alternativas: RETIRADA / RECHAZADA.
Referencias externas: IncidenteId · ReferenciaPoliza
Invariantes:
1. Debe existir póliza aplicable e incidente/daño que justifique la reclamación.
2. Una reclamación presentada no se elimina; cambios posteriores quedan versionados.
3. Se conserva la respuesta de aseguradora antes de marcar RESUELTA.
4. En esta iteración se registra la comunicación/respuesta; no se presupone API automática de aseguradora.</documentation>
        </element>
        <element xsi:type="archimate:DataObject" name="EstadoReclamacion «Value Object»" id="dc2c4e27-f7c8-4533-bc41-ee10ce4622f5">
          <documentation>Objeto de valor del agregado ReclamacionSeguro; se define por sus valores, no por identidad independiente.</documentation>
        </element>
        <element xsi:type="archimate:DataObject" name="ReferenciaCasoAseguradora «Value Object»" id="a18f7b1a-3d37-482e-9dd6-c3545ef3071a">
          <documentation>Objeto de valor del agregado ReclamacionSeguro; se define por sus valores, no por identidad independiente.</documentation>
        </element>
        <element xsi:type="archimate:DataObject" name="CoberturaReclamada «Value Object»" id="6a862394-45a5-4c3e-8501-88581ce2b7a9">
          <documentation>Objeto de valor del agregado ReclamacionSeguro; se define por sus valores, no por identidad independiente.</documentation>
        </element>
        <element xsi:type="archimate:DataObject" name="AbrirIncidente «Command»" id="7edd714a-ea1a-4817-b7a8-525e5e38b788">
          <documentation>Mapeo DDD→ArchiMate: Data Object que representa una intención/solicitud. No es un metatipo nativo de ArchiMate.</documentation>
