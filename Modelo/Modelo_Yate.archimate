      <property key="Salida" value="Pago registrado."/>
      <property key="Reglas de negocio" value="40% al reservar, 60% a 7 días de la entrega; recargos de temporada incluidos."/>
      <property key="Errores y excepciones" value="Pago rechazado."/>
      <property key="Calidad" value="Resultado en línea (propuesto)."/>
      <property key="Etapa del E2E" value="Reservar, contratar y asegurar (40%) y Preparar el yate (60%)"/>
