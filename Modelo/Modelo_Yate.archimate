    <element xsi:type="archimate:Capability" name="Gestión Comercial y de Clientes" id="id-450d211df60f43a78ca4dc6662c4e008">
      <documentation>Captación por canales digitales (45%), agencias y hoteles (30%) y referidos (25%); reservas, tarifas por día/noche con recargos de temporada.</documentation>
      <property key="Nivel" value="1"/>
    </element>
    <element xsi:type="archimate:Capability" name="Marketing y captación de clientes" id="id-89b5f4e3573c4d73a3648dc9a1cebd76">
      <property key="Nivel" value="2"/>
      <property key="Relación con la solución" value="Sin impacto directo"/>
    </element>
