    </element>
    <element xsi:type="archimate:Capability" name="Evaluación de riesgo del cliente" id="id-ae275f7e0b25410b8560519bee113ea7">
      <property key="Nivel" value="2"/>
      <property key="Relación con la solución" value="Impacta (alta)"/>
    </element>
    <element xsi:type="archimate:Capability" name="Seguimiento y Control de la Navegación" id="id-5bad92fc1d6b4552be9c2c3a0a29d0d4">
      <documentation>Dispositivo GPS y sensor de combustible en cada yate; actualización cada 30 s navegando y cada 5 min en puerto; zona máxima de 20 millas.</documentation>
      <property key="Nivel" value="1"/>
    </element>
    <element xsi:type="archimate:Capability" name="Control de zona permitida y alertas" id="id-e2f56b586f604cf99ddeb69e537f38d7">
      <property key="Nivel" value="2"/>
      <property key="Relación con la solución" value="Impacta (alta)"/>
    </element>
