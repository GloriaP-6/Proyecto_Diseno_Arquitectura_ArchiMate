      <element xsi:type="archimate:ServingRelationship" name="Conformista" id="id-422e9dc2501a4f27b60118dfe2c37ee9" source="id-caee19e05fe24ec2a7e6bca3a1317b82" target="id-0ed048de8040429eb266fc99f0c469cb">
        <property key="Patrón" value="Conformista"/>
        <property key="Upstream" value="Gestión de Marinas y Operación Náutica"/>
        <property key="Downstream" value="Liquidación Económica"/>
        <property key="Eventos U→D" value="InspeccionEmitida, YateRecibido"/>
        <property key="Eventos D→U" value="—"/>
        <property key="Justificación" value="Liquidación adopta el informe de inspección tal como lo publica la marina; no necesita negociar su formato."/>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="ArrendamientoCerrado" id="id-43914f1061894782a10faf5cdbead071" source="id-057ddd6e74c64b30a2f3c43432ce1ab4" target="id-1c8b5b0b60b943929f4ad4c1461f396e">
        <property key="Eventos" value="ArrendamientoCerrado"/>
      </element>
