    <element xsi:type="archimate:ApplicationComponent" name="BC Gestión del Arrendamiento" id="id-18b99d38c3ff40ca9e581dec4556e781">
      <documentation>Orquesta el ciclo del arriendo y decide cuándo una reserva se confirma o un arriendo inicia; solo avanza con evidencias de otros contextos.</documentation>
      <property key="Clasificación del subdominio implementado" value="Core"/>
      <property key="Dominio(s) de Fase 3" value="Gestión del Arrendamiento"/>
      <property key="Agregados (Fase 4)" value="Arrendamiento"/>
      <property key="Responsable lógico" value="Área de operación / plataforma"/>
      <property key="Lenguaje ubicuo clave" value="Solicitud de reserva, Reserva, Arriendo, Contrato de arriendo, Elegibilidad del arrendatario, Cierre del arriendo"/>
      <property key="Servicios de gestión (Fase 2)" value="G2, G4, G11"/>
      <property key="Decisión de agrupamiento" value="En este caso se mantiene un contexto por dominio porque cada uno preserva un modelo y lenguaje consistentes, invariantes y datos propios, y presenta un ritmo de cambio o una responsabilidad operativa diferenciable. No es una regla general de DDD."/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="BC Decisión de Riesgo del Arrendamiento" id="id-a4e97d05bc474260bd7e3d68cd384ac8">
      <documentation>La empresa no delega la decisión de aceptar, condicionar o rechazar el riesgo de entregar un activo ajeno; el resultado del evaluador es solo un insumo.</documentation>
      <property key="Clasificación del subdominio implementado" value="Core"/>
      <property key="Dominio(s) de Fase 3" value="Decisión de Riesgo del Arrendamiento"/>
      <property key="Agregados (Fase 4)" value="EvaluacionRiesgoArriendo"/>
      <property key="Responsable lógico" value="Área interna de riesgos"/>
      <property key="Lenguaje ubicuo clave" value="Resultado de evaluación externa, Decisión de riesgo, Condición de riesgo, Exposición del arriendo"/>
      <property key="Servicios de gestión (Fase 2)" value="G3"/>
      <property key="Decisión de agrupamiento" value="En este caso se mantiene un contexto por dominio porque cada uno preserva un modelo y lenguaje consistentes, invariantes y datos propios, y presenta un ritmo de cambio o una responsabilidad operativa diferenciable. No es una regla general de DDD."/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="BC Gestión de Propietarios y Yates" id="id-f98257aee2a44ff991c94e1f4531a021">
      <documentation>Controla la aptitud del activo ajeno y la relación con su dueño: habilitación, bloqueos, documentación y póliza anual.</documentation>
      <property key="Clasificación del subdominio implementado" value="Core"/>
      <property key="Dominio(s) de Fase 3" value="Gestión de Propietarios y Yates"/>
      <property key="Agregados (Fase 4)" value="VinculacionPropietario; YateComercializable"/>
      <property key="Responsable lógico" value="Área de operación / gestión de propietarios"/>
      <property key="Lenguaje ubicuo clave" value="Propietario, Yate, Habilitación, Bloqueo, Póliza anual"/>
      <property key="Servicios de gestión (Fase 2)" value="G1"/>
      <property key="Decisión de agrupamiento" value="En este caso se mantiene un contexto por dominio porque cada uno preserva un modelo y lenguaje consistentes, invariantes y datos propios, y presenta un ritmo de cambio o una responsabilidad operativa diferenciable. No es una regla general de DDD."/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="BC Gestión de Marinas y Operación Náutica" id="id-b0b7c2f7d17c4e0d8bebe7e8ecfac094">
      <documentation>Ejecuta físicamente el arriendo con la marina y el capitán; la marina opera directamente en la plataforma (portal A06).</documentation>
      <property key="Clasificación del subdominio implementado" value="Core"/>
      <property key="Dominio(s) de Fase 3" value="Gestión de Marinas y Operación Náutica"/>
      <property key="Agregados (Fase 4)" value="VinculacionMarina; OperacionNautica"/>
      <property key="Responsable lógico" value="Área de operación + operador de marina"/>
      <property key="Lenguaje ubicuo clave" value="Marina, Orden de alistamiento, Alistamiento, Entrega, Inspección, Capitán independiente"/>
      <property key="Servicios de gestión (Fase 2)" value="G5"/>
      <property key="Decisión de agrupamiento" value="En este caso se mantiene un contexto por dominio porque cada uno preserva un modelo y lenguaje consistentes, invariantes y datos propios, y presenta un ritmo de cambio o una responsabilidad operativa diferenciable. No es una regla general de DDD."/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="BC Gestión de Incidentes y Siniestros" id="id-2464873d244646eea0e02be9f684fc5f">
      <documentation>Gestiona novedades críticas, daños, peritajes y reclamaciones al seguro.</documentation>
