    <folder name="Fase 5 - Relations - Fase 5" id="id-51fa7aa3b1c74e0597e5f7004ef23d03">
      <element xsi:type="archimate:ServingRelationship" name="Conformista" id="id-02a9ca3839bd4e63859826adfcc48a19" source="id-222f7a91444c4f59b7f6fb017d475210" target="id-5c13bf8793104972988fe40d38089a1a">
        <property key="Patrón" value="Conformista"/>
        <property key="Upstream" value="Gestión del Arrendamiento"/>
        <property key="Downstream" value="Analítica y Reportes"/>
        <property key="Eventos U→D" value="ArrendamientoCerrado"/>
        <property key="Eventos D→U" value="—"/>
        <property key="Justificación" value="Analítica consume lo publicado sin modificar nada (conformista)."/>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="ArrendamientoCerrado" id="id-03bb4b5934e940c0a400aeb3730894f0" source="id-057ddd6e74c64b30a2f3c43432ce1ab4" target="id-5c13bf8793104972988fe40d38089a1a">
        <property key="Eventos" value="ArrendamientoCerrado"/>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="SolicitudReservaCreada, ElegibilidadValidada" id="id-06ce23e0d70f4df69e34c3605077b52d" source="id-057ddd6e74c64b30a2f3c43432ce1ab4" target="id-d72aa552c98f4a17bb4a0b58cce78a3e">
        <property key="Eventos" value="SolicitudReservaCreada, ElegibilidadValidada"/>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="ReservaConfirmada, ReservaCancelada" id="id-07309d28e60a4eb8b46e31da21f741b8" source="id-057ddd6e74c64b30a2f3c43432ce1ab4" target="id-bdcdd208881b4bdab0a34304467b2d02">
        <property key="Eventos" value="ReservaConfirmada, ReservaCancelada"/>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="YatePreparado, YateEntregado +5" id="id-1247afea195b4169866beae478cc0985" source="id-bdcdd208881b4bdab0a34304467b2d02" target="id-057ddd6e74c64b30a2f3c43432ce1ab4">
        <property key="Eventos" value="YatePreparado, YateEntregado, YateRecibido, InspeccionEmitida, EntregaAutorizada, EntregaSuspendida, CapitanConfirmado"/>
      </element>
      <element xsi:type="archimate:ServingRelationship" name="ACL · LP" id="id-180d61b111104dd98bba2e84d3b82b72" source="id-4a4274651313427fa3385fb906c876ad" target="id-5b1d8c36b2e14484a96372257e43c31d">
        <property key="Patrón" value="ACL, Lenguaje publicado"/>
        <property key="Upstream" value="Reputación y Calidad"/>
        <property key="Downstream" value="Gestión de Propietarios y Yates"/>
        <property key="Eventos U→D" value="SuspensionPorReputacionRequerida"/>
        <property key="Eventos D→U" value="—"/>
        <property key="Justificación" value="Bloqueo es polisémico: para Reputación es una restricción por umbrales; para Propietarios y Yates es un estado del yate. Propietarios (Core) protege su modelo con una capa anticorrupción que traduce la suspensión en su propio bloqueo."/>
      </element>
      <element xsi:type="archimate:AssociationRelationship" name="ACL manual (A04) · siniestro" id="id-1aadf0d5609e4eecb15d6d565bb1dff4" source="id-2433edf8cd3a40dc914ade0592bf6806" target="id-1ecb0b37e3a54199b90f5ccccd70e763"/>
      <element xsi:type="archimate:AssociationRelationship" name="Caminos separados (A03)" id="id-1e7e9ad2e046453e89d5b815657d5dd0" source="id-7cb1bd40b2174a68b957d7ae91972faa" target="id-057ddd6e74c64b30a2f3c43432ce1ab4"/>
      <element xsi:type="archimate:ServingRelationship" name="Cliente-Proveedor · LP" id="id-203e46ebc5684f2280ba90eee4ae1889" source="id-e69b4b8ac2394014a239f36057b981b7" target="id-bdcdd208881b4bdab0a34304467b2d02">
        <property key="Patrón" value="Cliente-Proveedor + Lenguaje publicado"/>
        <property key="Upstream" value="Decisión de Riesgo del Arrendamiento"/>
        <property key="Downstream" value="Gestión de Marinas y Operación Náutica"/>
        <property key="Eventos U→D" value="RiesgoCondicionado"/>
        <property key="Eventos D→U" value="—"/>
        <property key="Justificación" value="Liquidación decide cuánto y publica un contrato estable de cierre económico; Pagos y Facturación consume esas instrucciones para ejecutar o registrar movimientos. No comparten un modelo mutable ni requieren un núcleo compartido."/>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="CalificacionRegistrada" id="id-248cb18294f642958db8288b87f724bd" source="id-1c8b5b0b60b943929f4ad4c1461f396e" target="id-5c13bf8793104972988fe40d38089a1a">
        <property key="Eventos" value="CalificacionRegistrada"/>
      </element>
      <element xsi:type="archimate:AssociationRelationship" name="Caminos separados" id="id-27c5560409b94ca9a644f35326cf9192" source="id-d72aa552c98f4a17bb4a0b58cce78a3e" target="id-629e00fe3d324f4ab65ee7e1dff698e4">
        <property key="Patrón" value="Caminos separados"/>
        <property key="Upstream" value="Decisión de Riesgo del Arrendamiento"/>
        <property key="Downstream" value="Admisibilidad y Cumplimiento"/>
        <property key="Eventos U→D" value="—"/>
        <property key="Eventos D→U" value="—"/>
        <property key="Justificación" value="Riesgo y Cumplimiento no se consumen eventos entre sí. Se mantienen independientes a propósito (preguntas distintas, responsables distintos, términos polisémicos Aprobación y Alerta); solo coinciden en consumir las mismas entradas de Arrendamiento."/>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="CumplimientoAprobado, CumplimientoBloqueado" id="id-2ef52f4c9a9c46f4a2f0a55b6b44864b" source="id-629e00fe3d324f4ab65ee7e1dff698e4" target="id-057ddd6e74c64b30a2f3c43432ce1ab4">
        <property key="Eventos" value="CumplimientoAprobado, CumplimientoBloqueado"/>
      </element>
      <element xsi:type="archimate:AssociationRelationship" name="ACL manual (A05)" id="id-33707c0c56f848ea92736196bb3c3be4" source="id-dd8de45e43d848418452fb4892741f7a" target="id-d72aa552c98f4a17bb4a0b58cce78a3e"/>
