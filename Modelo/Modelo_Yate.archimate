      <property key="Nivel" value="2"/>
      <property key="Relación con la solución" value="Sin impacto directo"/>
    </element>
    <element xsi:type="archimate:Capability" name="Gestión de Marinas y Operación en Puerto" id="id-4b93250bd00248ff8d69a73a945c3b89">
      <documentation>6 marinas. La marina alista, entrega y recibe el yate y puede suspender la entrega por condiciones del yate o clima.</documentation>
      <property key="Nivel" value="1"/>
    </element>
    <element xsi:type="archimate:Capability" name="Desarrollo de la red de marinas" id="id-6b886b379df146389f9a38bc8975138d">
