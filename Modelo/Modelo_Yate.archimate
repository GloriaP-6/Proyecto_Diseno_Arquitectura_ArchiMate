    <folder name="Fase 5 - Application - Fase 5" id="id-fed75303ef98455e95643ffdea27c2fb">
      <element xsi:type="archimate:ApplicationComponent" name="Canales de distribución (externo)" id="id-4172991fe3994d56bfab643f2cc0066a">
        <documentation>Externo: Agencias de viaje, hoteles y canales digitales. No lo construimos; solo nos integramos a través de A01 Interfaz con canales de distribución.</documentation>
        <property key="Tipo" value="Externo"/>
        <property key="Tipo de externo" value="Canal comercial (tercero)"/>
        <property key="Externo" value="Agencias de viaje, hoteles y canales digitales"/>
        <property key="Patrón hoy" value="Caminos separados (sin integración automática en esta versión)"/>
        <property key="Patrón si se automatiza" value="OHS: la plataforma publicaría la cotización"/>
        <property key="Contexto que lo cubre" value="Tarifación y Cotización"/>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="BC Gestión del Arrendamiento" id="id-057ddd6e74c64b30a2f3c43432ce1ab4">
        <documentation>Orquesta el ciclo del arriendo y decide cuándo una reserva se confirma o un arriendo inicia; solo avanza con evidencias de otros contextos.</documentation>
        <property key="Clasificación del subdominio implementado" value="Core"/>
        <property key="Dominio(s) de Fase 3" value="Gestión del Arrendamiento"/>
        <property key="Agregados (Fase 4)" value="Arrendamiento"/>
        <property key="Responsable lógico" value="Área de operación / plataforma"/>
        <property key="Lenguaje ubicuo clave" value="Solicitud de reserva, Reserva, Arriendo, Contrato de arriendo, Elegibilidad del arrendatario, Cierre del arriendo"/>
        <property key="Servicios de gestión (Fase 2)" value="G2, G4, G11"/>
        <property key="Decisión de agrupamiento" value="En este caso se mantiene un contexto por dominio porque cada uno preserva un modelo y lenguaje consistentes, invariantes y datos propios, y presenta un ritmo de cambio o una responsabilidad operativa diferenciable. No es una regla general de DDD."/>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="BC Pagos y Facturación" id="id-0bf327aac9cc49f3a14eaedeef182a15">
        <documentation>Ejecuta cobros, preautorizaciones y reembolsos y se comunica con la pasarela y el sistema contable/facturador; es la frontera tecnológica real.</documentation>
        <property key="Clasificación del subdominio implementado" value="Generic"/>
        <property key="Dominio(s) de Fase 3" value="Pagos y Facturación"/>
        <property key="Agregados (Fase 4)" value="TransaccionPago; RegistroFacturacion"/>
        <property key="Responsable lógico" value="Área financiera / administrativa"/>
        <property key="Lenguaje ubicuo clave" value="Transacción de pago, Preautorización, Reembolso, Registro de facturación"/>
        <property key="Servicios de gestión (Fase 2)" value="G7"/>
        <property key="Decisión de agrupamiento" value="En este caso se mantiene un contexto por dominio porque cada uno preserva un modelo y lenguaje consistentes, invariantes y datos propios, y presenta un ritmo de cambio o una responsabilidad operativa diferenciable. No es una regla general de DDD."/>
      </element>
