        <property key="Eventos" value="IncidenteResuelto"/>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="RiesgoAprobado, RiesgoCondicionado +1" id="id-4e62cdad7901463f887c765e7b940071" source="id-d72aa552c98f4a17bb4a0b58cce78a3e" target="id-057ddd6e74c64b30a2f3c43432ce1ab4">
        <property key="Eventos" value="RiesgoAprobado, RiesgoCondicionado, RiesgoRechazado"/>
      </element>
      <element xsi:type="archimate:ServingRelationship" name="Cliente-Proveedor" id="id-51c76611ab1a4d83bebad8128683281d" source="id-caee19e05fe24ec2a7e6bca3a1317b82" target="id-1ecb0b37e3a54199b90f5ccccd70e763">
        <property key="Patrón" value="Cliente-Proveedor"/>
        <property key="Upstream" value="Gestión de Marinas y Operación Náutica"/>
        <property key="Downstream" value="Gestión de Incidentes y Siniestros"/>
        <property key="Eventos U→D" value="DanioDetectado"/>
        <property key="Eventos D→U" value="—"/>
        <property key="Justificación" value="Incidentes es cliente: define qué información mínima necesita de la marina al detectar un daño; Marinas es proveedor."/>
      </element>
      <element xsi:type="archimate:ServingRelationship" name="Cliente-Proveedor" id="id-59e5ceabf6df4d8db766e9f772e8797d" source="id-ff3f0e8681cc4f3ea60c867c0cb68a60" target="id-057ddd6e74c64b30a2f3c43432ce1ab4">
        <property key="Patrón" value="Cliente-Proveedor"/>
        <property key="Upstream" value="Liquidación Económica"/>
        <property key="Downstream" value="Gestión del Arrendamiento"/>
        <property key="Eventos U→D" value="LiquidacionFinalizada"/>
        <property key="Eventos D→U" value="—"/>
        <property key="Justificación" value="Arrendamiento (Core) es cliente: no cierra hasta recibir la liquidación finalizada; Liquidación es proveedor."/>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="AnticipoPagado, DepositoPreautorizado +2" id="id-5fc20713d05940e28b2f60d52bd91379" source="id-0bf327aac9cc49f3a14eaedeef182a15" target="id-057ddd6e74c64b30a2f3c43432ce1ab4">
        <property key="Eventos" value="AnticipoPagado, DepositoPreautorizado, DepositoResuelto, SaldoPagado"/>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="LiquidacionFinalizada" id="id-62cdcc5d6aaa40f081951b43053209c0" source="id-0ed048de8040429eb266fc99f0c469cb" target="id-5c13bf8793104972988fe40d38089a1a">
        <property key="Eventos" value="LiquidacionFinalizada"/>
      </element>
      <element xsi:type="archimate:ServingRelationship" name="Conformista" id="id-645a8887a14744bd8e691f6dd12a14bc" source="id-4a4274651313427fa3385fb906c876ad" target="id-5c13bf8793104972988fe40d38089a1a">
        <property key="Patrón" value="Conformista"/>
        <property key="Upstream" value="Reputación y Calidad"/>
        <property key="Downstream" value="Analítica y Reportes"/>
        <property key="Eventos U→D" value="CalificacionRegistrada"/>
        <property key="Eventos D→U" value="—"/>
        <property key="Justificación" value="Analítica consume lo publicado sin modificar nada (conformista)."/>
      </element>
      <element xsi:type="archimate:ServingRelationship" name="ACL · LP" id="id-650507dd1402464f9495e996c4ddae12" source="id-e0ab4a06453e4d3f942b29d4e6c954b8" target="id-6046262de2154eb28d48475621773dc2">
        <property key="Patrón" value="ACL, Lenguaje publicado"/>
        <property key="Upstream" value="Pagos y Facturación"/>
        <property key="Downstream" value="Gestión del Arrendamiento"/>
        <property key="Eventos U→D" value="AnticipoPagado, DepositoPreautorizado, DepositoResuelto, SaldoPagado"/>
        <property key="Eventos D→U" value="—"/>
        <property key="Justificación" value="Arrendamiento (Core) no debe quedar subordinado al contexto genérico: una capa anticorrupción traduce los resultados de pago a sus referencias (ReferenciaAnticipo, ReferenciaSaldo, ReferenciaDeposito)."/>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="SuspensionPorReputacionRequerida" id="id-65fa72b8627a4d6b9b1964a83faad2ac" source="id-1c8b5b0b60b943929f4ad4c1461f396e" target="id-9d4d136f334a40ac8b7966f8d1a73a8f">
        <property key="Eventos" value="SuspensionPorReputacionRequerida"/>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="RiesgoCondicionado" id="id-6621aa50eda54211bdabde6498957450" source="id-d72aa552c98f4a17bb4a0b58cce78a3e" target="id-bdcdd208881b4bdab0a34304467b2d02">
        <property key="Eventos" value="RiesgoCondicionado"/>
      </element>
      <element xsi:type="archimate:ServingRelationship" name="Cliente-Proveedor · LP" id="id-682a2bb4757b44cdb2df247364885123" source="id-a1dae6ecb1cd40b48bed4abda42ab548" target="id-057ddd6e74c64b30a2f3c43432ce1ab4">
        <property key="Patrón" value="Cliente-Proveedor + Lenguaje publicado"/>
        <property key="Upstream" value="Admisibilidad y Cumplimiento"/>
        <property key="Downstream" value="Gestión del Arrendamiento"/>
        <property key="Eventos U→D" value="CumplimientoAprobado, CumplimientoBloqueado"/>
        <property key="Eventos D→U" value="SolicitudReservaCreada, ElegibilidadValidada"/>
        <property key="Justificación" value="Liquidación decide cuánto y publica un contrato estable de cierre económico; Pagos y Facturación consume esas instrucciones para ejecutar o registrar movimientos. No comparten un modelo mutable ni requieren un núcleo compartido."/>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="LiquidacionFinalizada" id="id-68f83c0ac9b646b7a83fc1e750a41f4f" source="id-0ed048de8040429eb266fc99f0c469cb" target="id-057ddd6e74c64b30a2f3c43432ce1ab4">
        <property key="Eventos" value="LiquidacionFinalizada"/>
      </element>
      <element xsi:type="archimate:AssociationRelationship" name="Acceso directo al portal (A06)" id="id-785db9ebcf7747dba61d4860b29e0c72" source="id-e4ca1b393d1e4a419ec0a4d578eae8bd" target="id-bdcdd208881b4bdab0a34304467b2d02"/>
