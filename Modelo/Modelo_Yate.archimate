        <property key="Patrón" value="Conformista"/>
        <property key="Upstream" value="Gestión del Arrendamiento"/>
        <property key="Downstream" value="Reputación y Calidad"/>
        <property key="Eventos U→D" value="ArrendamientoCerrado"/>
        <property key="Eventos D→U" value="—"/>
        <property key="Justificación" value="Reputación solo reacciona al cierre del arriendo; adopta el evento tal cual (conformista)."/>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="Facturas y liquidaciones" id="id-3a23da8ab52246f2a793665ec0f5757e" source="id-28b821c821dd4bd499f54f49e4326d36" target="id-7378a6b7f38d445fb35c854a88de5154"/>
      <element xsi:type="archimate:FlowRelationship" name="Cobros, pre-autorizaciones, capturas y reembolsos" id="id-cfd07ac321fc45619e940d757c9400f9" source="id-67e7079ba89641e483b806da07a0fd93" target="id-f541690c4871400ea81fd389dc6df6c3"/>
