    </element>
    <element xsi:type="archimate:ApplicationComponent" name="BC Tarifación y Cotización" id="id-e8f7a4f281be437a8064173615a35dd2">
      <documentation>Calcula precio, temporada y depósito estimado antes de la reserva; apoya al núcleo sin diferenciarlo.</documentation>
      <property key="Clasificación del subdominio implementado" value="Supporting"/>
      <property key="Dominio(s) de Fase 3" value="Tarifación y Cotización"/>
      <property key="Agregados (Fase 4)" value="Cotizacion"/>
      <property key="Responsable lógico" value="Plataforma / asesor comercial"/>
      <property key="Lenguaje ubicuo clave" value="Tarifa, Temporada, Cotización, Depósito estimado"/>
