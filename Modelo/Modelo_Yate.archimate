    <element xsi:type="archimate:Resource" name="Cartera de propietarios y flota de 85 yates" id="id-28faeac38ac04f80b618309ec6a633f9"/>
    <element xsi:type="archimate:Resource" name="Red de 6 marinas aliadas" id="id-83660411136f40b6a517f5530e4a6c63"/>
