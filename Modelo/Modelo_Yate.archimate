        <documentation>Servicio que el contexto ofrece a los demás: eventos del lenguaje publicado y consultas de su modelo.</documentation>
        <property key="Contexto" value="SEG"/>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="BC Liquidación Económica" id="id-0ed048de8040429eb266fc99f0c469cb">
        <documentation>Decide cuánto corresponde económicamente al cierre (combustible, retrasos, daños, depósito y reparto).</documentation>
