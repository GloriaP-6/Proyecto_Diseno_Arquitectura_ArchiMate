        <property key="Eventos" value="AlertaOperacionalEscalada"/>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="InspeccionEmitida, YateRecibido" id="id-7e6b9f39eb434a46be6e874f9b38b04f" source="id-bdcdd208881b4bdab0a34304467b2d02" target="id-0ed048de8040429eb266fc99f0c469cb">
        <property key="Eventos" value="InspeccionEmitida, YateRecibido"/>
      </element>
      <element xsi:type="archimate:AssociationRelationship" name="ACL manual (A12)" id="id-7f05106d4a3349e297243d6e2aa0591c" source="id-98a372a5d466401492bbbb3be88503cc" target="id-1ecb0b37e3a54199b90f5ccccd70e763"/>
      <element xsi:type="archimate:ServingRelationship" name="Cliente-Proveedor" id="id-80c02de383f147e2a7154f03fa158430" source="id-becccd8a9b504a84925137436323dcce" target="id-0ed048de8040429eb266fc99f0c469cb">
        <property key="Patrón" value="Cliente-Proveedor"/>
        <property key="Upstream" value="Gestión de Incidentes y Siniestros"/>
        <property key="Downstream" value="Liquidación Económica"/>
        <property key="Eventos U→D" value="IncidenteResuelto, ReclamacionResuelta"/>
        <property key="Eventos D→U" value="—"/>
        <property key="Justificación" value="Liquidación es cliente: necesita el resultado económico del siniestro (valor, cobertura) y puede pedir ajustes al contrato del evento."/>
      </element>
      <element xsi:type="archimate:ServingRelationship" name="Conformista" id="id-80cc4d24ac6248a1bb74daaa54b9dc1a" source="id-b5f6f9b31a314198b0b29c54729b8ce1" target="id-39bb9fb9a96b40e6bac202b82d304bf3">
        <property key="Patrón" value="Conformista"/>
        <property key="Upstream" value="Gestión de Propietarios y Yates"/>
        <property key="Downstream" value="Tarifación y Cotización"/>
        <property key="Eventos U→D" value="DisponibilidadConfirmada, DisponibilidadNegada"/>
        <property key="Eventos D→U" value="—"/>
        <property key="Justificación" value="Tarifación solo necesita saber si hay o no disponibilidad para cotizar; adopta tal cual el lenguaje publicado de Propietarios (conformista) porque no tiene interés en negociarlo y es un contexto de apoyo."/>
      </element>
      <element xsi:type="archimate:AssociationRelationship" name="Fuera de alcance (A13)" id="id-8441f0b0f42c4eaebaa730103ac5fb3e" source="id-d20c33d89fed499eb5c098d6df684739" target="id-bdcdd208881b4bdab0a34304467b2d02"/>
      <element xsi:type="archimate:FlowRelationship" name="DisponibilidadConfirmada, DisponibilidadNegada +1" id="id-84fbb4a2d3544d80ae15bc67c87e8cea" source="id-9d4d136f334a40ac8b7966f8d1a73a8f" target="id-057ddd6e74c64b30a2f3c43432ce1ab4">
        <property key="Eventos" value="DisponibilidadConfirmada, DisponibilidadNegada, YateBloqueado"/>
      </element>
      <element xsi:type="archimate:ServingRelationship" name="Conformista" id="id-8ac09ab33cc6407a87d5d7bb04e9b22b" source="id-becccd8a9b504a84925137436323dcce" target="id-5c13bf8793104972988fe40d38089a1a">
        <property key="Patrón" value="Conformista"/>
        <property key="Upstream" value="Gestión de Incidentes y Siniestros"/>
        <property key="Downstream" value="Analítica y Reportes"/>
        <property key="Eventos U→D" value="IncidenteResuelto"/>
        <property key="Eventos D→U" value="—"/>
        <property key="Justificación" value="Analítica consume lo publicado sin modificar nada (conformista)."/>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="IncidenteResuelto, ReclamacionResuelta" id="id-8e612d7e697443659e7592023475eb18" source="id-1ecb0b37e3a54199b90f5ccccd70e763" target="id-0ed048de8040429eb266fc99f0c469cb">
        <property key="Eventos" value="IncidenteResuelto, ReclamacionResuelta"/>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="AjusteLiquidacionRegistrado, CierreEconomicoPreparado +1" id="id-91cfe0546ce84b1a809896b763be87b7" source="id-0ed048de8040429eb266fc99f0c469cb" target="id-0bf327aac9cc49f3a14eaedeef182a15">
        <property key="Eventos" value="AjusteLiquidacionRegistrado, CierreEconomicoPreparado, DepositoAplicado"/>
      </element>
      <element xsi:type="archimate:ServingRelationship" name="Cliente-Proveedor · LP" id="id-93e1b46f609e401c97e090a955e6d072" source="id-e69b4b8ac2394014a239f36057b981b7" target="id-057ddd6e74c64b30a2f3c43432ce1ab4">
        <property key="Patrón" value="Cliente-Proveedor + Lenguaje publicado"/>
        <property key="Upstream" value="Decisión de Riesgo del Arrendamiento"/>
        <property key="Downstream" value="Gestión del Arrendamiento"/>
        <property key="Eventos U→D" value="RiesgoAprobado, RiesgoCondicionado, RiesgoRechazado"/>
        <property key="Eventos D→U" value="SolicitudReservaCreada, ElegibilidadValidada"/>
        <property key="Justificación" value="Liquidación decide cuánto y publica un contrato estable de cierre económico; Pagos y Facturación consume esas instrucciones para ejecutar o registrar movimientos. No comparten un modelo mutable ni requieren un núcleo compartido."/>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="ReputacionActualizada" id="id-96a1a24838ca40bfa867aa1da7ccc815" source="id-1c8b5b0b60b943929f4ad4c1461f396e" target="id-d72aa552c98f4a17bb4a0b58cce78a3e">
        <property key="Eventos" value="ReputacionActualizada"/>
      </element>
      <element xsi:type="archimate:ServingRelationship" name="Cliente-Proveedor" id="id-a19edd9e843448ceaf67a193a5fab623" source="id-0bfcb28da0f14ba9aa8b5f3b71df746e" target="id-1ecb0b37e3a54199b90f5ccccd70e763">
        <property key="Patrón" value="Cliente-Proveedor"/>
        <property key="Upstream" value="Seguimiento Operacional"/>
        <property key="Downstream" value="Gestión de Incidentes y Siniestros"/>
        <property key="Eventos U→D" value="AlertaOperacionalEscalada"/>
        <property key="Eventos D→U" value="—"/>
        <property key="Justificación" value="Seguimiento detecta y escala; Incidentes (Core) decide si abre un caso. Detectar una alerta no equivale a abrir un incidente, por eso Incidentes es cliente y define qué escalamiento acepta."/>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="DisponibilidadConfirmada, DisponibilidadNegada" id="id-a26b38ad24a8483da087ca6b7eec6f6f" source="id-9d4d136f334a40ac8b7966f8d1a73a8f" target="id-39bb9fb9a96b40e6bac202b82d304bf3">
        <property key="Eventos" value="DisponibilidadConfirmada, DisponibilidadNegada"/>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="Resultado de cada transacción" id="id-12474fd4b75d437ebb790e59d4f95c04" source="id-f541690c4871400ea81fd389dc6df6c3" target="id-67e7079ba89641e483b806da07a0fd93"/>
      <element xsi:type="archimate:FlowRelationship" name="SolicitudReservaCreada, ElegibilidadValidada" id="id-ad559a1384804d27bd898e26b86f4513" source="id-057ddd6e74c64b30a2f3c43432ce1ab4" target="id-629e00fe3d324f4ab65ee7e1dff698e4">
        <property key="Eventos" value="SolicitudReservaCreada, ElegibilidadValidada"/>
      </element>
      <element xsi:type="archimate:ServingRelationship" name="Cliente-Proveedor" id="id-b837805e1c7649b9b8deab0ab66cc036" source="id-709050ab76774b03a63156605447414b" target="id-057ddd6e74c64b30a2f3c43432ce1ab4">
        <property key="Patrón" value="Cliente-Proveedor"/>
        <property key="Upstream" value="Tarifación y Cotización"/>
        <property key="Downstream" value="Gestión del Arrendamiento"/>
        <property key="Eventos U→D" value="CotizacionAceptada"/>
        <property key="Eventos D→U" value="—"/>
        <property key="Justificación" value="Arrendamiento (Core) es cliente: exige que una cotización aceptada traiga precio, depósito estimado y vigencia; Tarifación (Supporting) es proveedor. Una cotización aceptada no se edita silenciosamente."/>
      </element>
      <element xsi:type="archimate:AssociationRelationship" name="Alianza" id="id-bab36063fa3c4fa189143255201ba740" source="id-057ddd6e74c64b30a2f3c43432ce1ab4" target="id-bdcdd208881b4bdab0a34304467b2d02">
        <property key="Patrón" value="Alianza"/>
        <property key="Upstream" value="Gestión del Arrendamiento"/>
        <property key="Downstream" value="Gestión de Marinas y Operación Náutica"/>
        <property key="Eventos U→D" value="ReservaConfirmada, ReservaCancelada"/>
        <property key="Eventos D→U" value="YatePreparado, YateEntregado, YateRecibido, InspeccionEmitida, EntregaAutorizada, EntregaSuspendida, CapitanConfirmado"/>
        <property key="Justificación" value="Dos Core que se necesitan mutuamente: la reserva confirmada dispara la preparación y los eventos de la marina hacen avanzar el arriendo. Ninguno es upstream de forma estable; se coordinan los cambios (alianza). Ambos publican en un servicio de host abierto con lenguaje publicado."/>
      </element>
      <element xsi:type="archimate:AssociationRelationship" name="Coordinación en plataforma (A11)" id="id-c2ae82d6484f493db83cf46666d2a3f5" source="id-a67ab9bb80bd42acac36ca2a39a73249" target="id-bdcdd208881b4bdab0a34304467b2d02"/>
      <element xsi:type="archimate:FlowRelationship" name="SolicitudReservaCreada" id="id-c5a744877e264096bf7cf96b5dc5890a" source="id-057ddd6e74c64b30a2f3c43432ce1ab4" target="id-9d4d136f334a40ac8b7966f8d1a73a8f">
        <property key="Eventos" value="SolicitudReservaCreada"/>
      </element>
      <element xsi:type="archimate:AssociationRelationship" name="Caminos separados (A08)" id="id-c690cc91915a4d6b91dfb6714b99660c" source="id-78d556d460b34d00be1af8e1814b1fc4" target="id-35cb2a6bc3c142e39745c98d973a5e5c"/>
      <element xsi:type="archimate:ServingRelationship" name="Conformista" id="id-c8c6465617004c5ab379534bf7770247" source="id-222f7a91444c4f59b7f6fb017d475210" target="id-0bf327aac9cc49f3a14eaedeef182a15">
        <property key="Patrón" value="Conformista"/>
        <property key="Upstream" value="Gestión del Arrendamiento"/>
        <property key="Downstream" value="Pagos y Facturación"/>
        <property key="Eventos U→D" value="ReservaConfirmada, ContratoArriendoFormalizado"/>
        <property key="Eventos D→U" value="—"/>
        <property key="Justificación" value="Pagos y Facturación (Generic) adopta el lenguaje de Arrendamiento para saber qué cobrar y cuándo; no tiene razón para imponer su modelo al Core."/>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="ArrendamientoIniciado, ArrendamientoDevuelto" id="id-cabe0e210282445ea5053ed9fed0cec1" source="id-057ddd6e74c64b30a2f3c43432ce1ab4" target="id-35cb2a6bc3c142e39745c98d973a5e5c">
