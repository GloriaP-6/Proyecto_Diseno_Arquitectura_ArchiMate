    <element xsi:type="archimate:Capability" name="Gestión de Propietarios y Flota" id="id-058420db82b941c09a299f58ac2b5124">
      <documentation>58 propietarios, 85 yates. Contrato de exclusividad de comercialización por 12 meses; el propietario habilita o bloquea su yate.</documentation>
      <property key="Nivel" value="1"/>
    </element>
    <element xsi:type="archimate:Capability" name="Contratación y vinculación de propietarios" id="id-f1d272b3cc5b4a4aa4e85ca3557a5457">
      <property key="Nivel" value="2"/>
      <property key="Relación con la solución" value="Impacta (parcial)"/>
    </element>
