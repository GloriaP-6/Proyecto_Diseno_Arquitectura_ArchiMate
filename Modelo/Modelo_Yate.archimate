    </element>
    <element xsi:type="archimate:ApplicationComponent" name="BC Seguimiento Operacional" id="id-74069fe4e9e5417f9da86f16cb354614">
      <documentation>Registra ubicación, combustible, zona y alertas durante el arriendo; detectar una alerta no equivale a abrir un incidente.</documentation>
      <property key="Clasificación del subdominio implementado" value="Supporting"/>
      <property key="Dominio(s) de Fase 3" value="Seguimiento Operacional"/>
      <property key="Agregados (Fase 4)" value="SeguimientoArriendo"/>
      <property key="Responsable lógico" value="Área de operación / plataforma"/>
      <property key="Lenguaje ubicuo clave" value="Posición, Zona permitida, Alerta operacional"/>
      <property key="Servicios de gestión (Fase 2)" value="G6"/>
      <property key="Decisión de agrupamiento" value="En este caso se mantiene un contexto por dominio porque cada uno preserva un modelo y lenguaje consistentes, invariantes y datos propios, y presenta un ritmo de cambio o una responsabilidad operativa diferenciable. No es una regla general de DDD."/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="BC Liquidación Económica" id="id-c315310fc5d6493abd669c8018f9e7f3">
      <documentation>Decide cuánto corresponde económicamente al cierre (combustible, retrasos, daños, depósito y reparto).</documentation>
      <property key="Clasificación del subdominio implementado" value="Supporting"/>
      <property key="Dominio(s) de Fase 3" value="Liquidación Económica"/>
      <property key="Agregados (Fase 4)" value="LiquidacionArrendamiento"/>
