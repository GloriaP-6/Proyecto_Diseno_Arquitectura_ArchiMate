      <property key="Externo" value="Red de capitanes independientes"/>
      <property key="Tipo de externo" value="Proveedor externo"/>
      <property key="Dirección" value="Ambas"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="La empresa pone el capitán desde una red independiente; sin integración la asignación seguiría siendo manual."/>
      <property key="Fuente" value="Ampliación (entrevista §3)"/>
      <property key="Capacidad" value="Gestión de capitanes"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="A12 Integración con peritos" id="id-ec78434a14ae48759ac5c2d86074c989">
      <documentation>Aísla a los servicios de gestión de: Peritos de daños.</documentation>
      <property key="Capa" value="Capa anticorrupción (interoperabilidad)"/>
      <property key="Externo" value="Peritos de daños"/>
      <property key="Tipo de externo" value="Proveedor externo"/>
      <property key="Dirección" value="Ambas"/>
      <property key="Decisión" value="Implementar"/>
      <property key="Justificación" value="Daños sobre COP 5M requieren perito; el dictamen alimenta el orden de cobro."/>
      <property key="Fuente" value="Ampliación (entrevista §5)"/>
      <property key="Capacidad" value="Gestión de incidentes y siniestros"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="A13 Integración con servicio meteorológico" id="id-501e72c6bc9b4169b4dacacc88c3b380">
      <documentation>Aísla a los servicios de gestión de: Servicio meteorológico y alertas de viento.</documentation>
      <property key="Capa" value="Capa anticorrupción (interoperabilidad)"/>
      <property key="Externo" value="Servicio meteorológico y alertas de viento"/>
      <property key="Tipo de externo" value="Proveedor externo (por definir)"/>
      <property key="Dirección" value="Hacia nosotros"/>
      <property key="Decisión" value="No implementar en esta versión"/>
      <property key="Justificación" value="El umbral de 25 nudos existe, pero la entrevista no identifica una fuente; hoy la marina suspende por clima (S18). Se confirma con el negocio."/>
      <property key="Fuente" value="Ampliación; por confirmar"/>
      <property key="Capacidad" value="Control de zona permitida y alertas"/>
    </element>
