      <property key="Salida" value="Pre-autorización, retención parcial o liberación."/>
      <property key="Reglas de negocio" value="Se pre-autoriza 48 h antes; es una pre-autorización, no un cobro; la empresa no custodia el dinero; devolución en 5 días hábiles (meta 3)."/>
      <property key="Errores y excepciones" value="Pre-autorización rechazada."/>
      <property key="Calidad" value="Devolución ≤ 5 días hábiles; meta 3 (entrevista §9)."/>
