  <folder name="Technology &amp; Physical" id="id-3643d3bc2101460a87c81799fee4345f" type="technology"/>
  <folder name="Motivation" id="id-03d17446f67a46f88ebc24e58867e8c0" type="motivation">
    <element xsi:type="archimate:Stakeholder" name="Inversionistas" id="id-adb3409ad20341559f5a891d40417fa2">
      <documentation>Quieren crecimiento con riesgo controlado.</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Propietarios de los yates" id="id-8a82a361bf084ebeb6722355d3b291e4">
      <documentation>Quieren que su yate vuelva sin daños y cobrar a tiempo.</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Marinas" id="id-14267ba1f85b48769dc266be05848ef5">
      <documentation>Quieren órdenes claras y pagos puntuales.</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Clientes (arrendatarios)" id="id-1af538a9f5fe46ada7df9c8ff67cd8b4">
      <documentation>Quieren rapidez, transparencia y confianza.</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Aseguradoras" id="id-ead2c32c579b4efeb39e9e6e2d1f0d50">
      <documentation>Quieren cumplimiento y trazabilidad.</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Autoridades marítimas y reguladores" id="id-5b68f2dcc4814e65a01246fd5311ff86">
      <documentation>Quieren cumplimiento y trazabilidad.</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="Crecimiento de la flota (de 85 a unos 150 yates)" id="id-526aa23f99cb4f68a5f64e609b78f953"/>
