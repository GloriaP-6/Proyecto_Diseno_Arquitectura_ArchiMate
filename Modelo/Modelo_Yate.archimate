      <property key="Operación" value="liquidarCombustible"/>
      <property key="Entrada" value="Acta de entrega, informe de inspección, precio de surtidor, hora de devolución."/>
      <property key="Salida" value="Valor a cobrar por combustible y retraso."/>
      <property key="Reglas de negocio" value="Se cobra lo consumido al precio de surtidor de la marina del día de la devolución, sin recargo; retraso: 1 h de tolerancia y 15% del valor diario por hora adicional."/>
      <property key="Errores y excepciones" value="Diferencia entre sensor y verificación manual > 3%."/>
      <property key="Calidad" value="Al cerrar el arriendo (propuesto)."/>
